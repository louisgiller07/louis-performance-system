# Public, client-safe Supabase config only. Never put a secret/service_role
# key in this file or in any VITE_* variable — everything prefixed VITE_ is
# bundled into the client-side JS and is publicly readable.

VITE_SUPABASE_URL=

# Prefer the new publishable key. If your project has not yet enabled it on
# the gateway, VITE_SUPABASE_ANON_KEY is accepted as a fallback (the legacy
# anon key is equally public/client-safe).
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
