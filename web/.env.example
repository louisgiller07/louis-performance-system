# Copy to web/.env.local (git-ignored, machine-local). Public, client-safe
# Supabase config only. Never put a secret/service_role key in this file or
# in any VITE_* variable — everything prefixed VITE_ is bundled into the
# client-side JS and is publicly readable.

# Recommended for development: the LOCAL Supabase stack (`npx supabase start`).
# The publishable key is printed by `npx supabase status -o env` (PUBLISHABLE_KEY).
VITE_SUPABASE_URL=http://127.0.0.1:54321

# Prefer the new publishable key. If your project has not yet enabled it on
# the gateway, VITE_SUPABASE_ANON_KEY is accepted as a fallback (the legacy
# anon key is equally public/client-safe).
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# Local dev safety: in development mode (`npm run dev`, vitest) the app refuses
# any non-local Supabase URL. Set this to exactly `true` only to work against a
# remote project on purpose. Production builds are not affected.
# VITE_ALLOW_REMOTE_SUPABASE_IN_DEV=true
