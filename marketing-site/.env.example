# Server-only — read exclusively by src/pages/api/contact.ts (a Vercel
# serverless function, see astro.config.mjs). Never prefix this PUBLIC_:
# Astro only inlines PUBLIC_*-prefixed vars into client-side JS, so an
# unprefixed name like this one never reaches the browser bundle.
#
# Get a key at https://resend.com (free tier). No domain verification is
# needed to send TO contact@nalynt.ch using the default onboarding@resend.dev
# sender — only a custom "from" domain would require that.
RESEND_API_KEY=
