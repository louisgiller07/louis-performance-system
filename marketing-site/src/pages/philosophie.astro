---
// V3 — same brand language as the homepage: hero, five convictions that
// light up as you read, what NALYNT forbids itself, closing CTA. Copy lives
// in content/pages.ts (philosophyPage); motion in scripts/motion.ts.
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/sections/PageHero.astro";
import Convictions from "../components/philosophy/Convictions.astro";
import StruckList from "../components/sections/StruckList.astro";
import FinalCta from "../components/sections/FinalCta.astro";
import { philosophyPage } from "../content/pages.ts";
---

<BaseLayout title={philosophyPage.meta.title} description={philosophyPage.meta.description} preloadDisplayFont>
  <PageHero hero={philosophyPage.hero} next="#convictions" />
  <Convictions />
  <StruckList index={philosophyPage.limits.index} kicker={philosophyPage.limits.kicker} items={philosophyPage.limits.items} />
  <FinalCta index={philosophyPage.cta.index} titleLines={philosophyPage.cta.titleLines} />
</BaseLayout>

<script>
  import "../scripts/motion.ts";
</script>
