---
// ART-02 — /philosophie: intro, the convictions read one after the other
// (they light as they cross the reading line), what NALYNT forbids itself,
// closing line. Copy: content/pages.ts (philosophyPage).
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/art/PageIntro.astro";
import Statements from "../components/art/Statements.astro";
import FinishLine from "../components/art/FinishLine.astro";
import { philosophyPage } from "../content/pages.ts";
---

<BaseLayout title={philosophyPage.meta.title} description={philosophyPage.meta.description}>
  <PageIntro copy={philosophyPage.intro} />
  <Statements id="convictions" title={philosophyPage.convictions.title} items={philosophyPage.convictions.items} variant="reading" />
  <Statements id="interdits" title={philosophyPage.limits.title} items={philosophyPage.limits.items} />
  <FinishLine title={philosophyPage.finish.title} lead={philosophyPage.finish.lead} />
</BaseLayout>
