---
// ART-02.1 — /comment-ca-marche: intro, the daily loop as a zigzag story with
// one small example screen per step, the three decisions around one race line
// that morphs to the decision you point at, what NALYNT does not do, closing
// line. Copy: content/pages.ts (howPage).
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/art/PageIntro.astro";
import LoopStory from "../components/art/LoopStory.astro";
import Decisions from "../components/art/Decisions.astro";
import Statements from "../components/art/Statements.astro";
import FinishLine from "../components/art/FinishLine.astro";
import { howPage } from "../content/pages.ts";
---

<BaseLayout title={howPage.meta.title} description={howPage.meta.description}>
  <PageIntro copy={howPage.intro} />
  <LoopStory />
  <Decisions />
  <Statements id="limites" title={howPage.promises.title} items={howPage.promises.items} />
  <FinishLine title={howPage.finish.title} lead={howPage.finish.lead} />
</BaseLayout>
