---
// V3 — same brand language as the homepage: hero, the daily loop, the three
// possible decisions, what NALYNT does not do, closing CTA. Copy lives in
// content/pages.ts (howPage); motion in scripts/motion.ts.
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/sections/PageHero.astro";
import HowLoop from "../components/how/HowLoop.astro";
import DecisionTrio from "../components/how/DecisionTrio.astro";
import StruckList from "../components/sections/StruckList.astro";
import FinalCta from "../components/sections/FinalCta.astro";
import { howPage } from "../content/pages.ts";
---

<BaseLayout title={howPage.meta.title} description={howPage.meta.description} preloadDisplayFont>
  <PageHero hero={howPage.hero} next="#boucle" />
  <HowLoop />
  <DecisionTrio />
  <StruckList index={howPage.promises.index} kicker={howPage.promises.kicker} items={howPage.promises.items} />
  <FinalCta index={howPage.cta.index} titleLines={howPage.cta.titleLines} />
</BaseLayout>

<script>
  import "../scripts/motion.ts";
</script>
