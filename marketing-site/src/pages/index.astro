---
// ART-02 — NALYNT race control homepage (local preview, not published).
// Opening (hero) → three acts held by one gold race line (Story): le point de
// départ (ActStart), le coaching quotidien (CoachingDemo + CoachingDomains),
// le jour de course (ActRace) → project, FAQ, closing line.
// Copy: content/home.ts and content/domains.ts. Behaviour: each component's
// own script, coordinated by scripts/core.ts.
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/art/Hero.astro";
import RealityBand from "../components/art/RealityBand.astro";
import Story from "../components/art/Story.astro";
import ActStart from "../components/art/ActStart.astro";
import CoachingDemo from "../components/art/CoachingDemo.astro";
import CoachingDomains from "../components/art/CoachingDomains.astro";
import ActRace from "../components/art/ActRace.astro";
import Project from "../components/art/Project.astro";
import Faq from "../components/art/Faq.astro";
import FinishLine from "../components/art/FinishLine.astro";
import { home } from "../content/home.ts";
---

<BaseLayout title={home.meta.title} description={home.meta.description} overlayHeader>
  <Hero />
  <RealityBand />
  <Story>
    <ActStart />
    <CoachingDemo />
    <CoachingDomains />
    <ActRace />
  </Story>
  <Project />
  <Faq />
  <FinishLine />
</BaseLayout>
