---
// V3 — Premium homepage: a seven-chapter brand experience (hero → problem →
// a day with NALYNT → how it works → the product → why NALYNT → final CTA).
// All copy lives in content/home.ts; all motion in scripts/motion.ts.
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeHero from "../components/home/HomeHero.astro";
import ProblemSection from "../components/home/ProblemSection.astro";
import DayStory from "../components/home/DayStory.astro";
import HowItWorks from "../components/home/HowItWorks.astro";
import ProductShowcase from "../components/home/ProductShowcase.astro";
import WhyNalynt from "../components/home/WhyNalynt.astro";
import FinalCta from "../components/sections/FinalCta.astro";
import { home } from "../content/home.ts";
---

<BaseLayout title={home.meta.title} description={home.meta.description} preloadDisplayFont>
  <HomeHero />
  <ProblemSection />
  <DayStory />
  <HowItWorks />
  <ProductShowcase />
  <WhyNalynt />
  <FinalCta />
</BaseLayout>

<script>
  import "../scripts/motion.ts";
</script>
