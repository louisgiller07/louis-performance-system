---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/ui/Section.astro";
import Container from "../components/ui/Container.astro";
import Badge from "../components/ui/Badge.astro";
import { siteCopy } from "../content/copy.ts";

// V1.6.1: "Contexte" (siteCopy.about.athleteContext) removed from this page —
// it was a verbatim duplicate of the homepage Credibility section (V1.6
// review finding). That field is still used as-is on `/` (CredibilityBlock,
// paired with the competition photo); athlete credibility on this page
// remains carried by "Origine" and "Pourquoi" below.
const items: Array<{ label: string; text: string }> = [
  { label: "Origine", text: siteCopy.about.origin },
  { label: "Pourquoi", text: siteCopy.about.whyItExists },
];
---

<BaseLayout title="À propos — NALYNT" description={siteCopy.about.whyItExists}>
  <Section index={1}>
    <Container class="max-w-2xl">
      <Badge>À propos</Badge>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight text-text sm:text-5xl">À propos</h1>

      <div class="mt-12 space-y-10">
        {
          items.map((item) => (
            <div>
              <Badge as="h2">{item.label}</Badge>
              <p class="mt-3 text-base leading-relaxed text-text-muted">{item.text}</p>
            </div>
          ))
        }
      </div>
    </Container>
  </Section>
</BaseLayout>
