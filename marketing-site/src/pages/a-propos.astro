---
// ART-02 — /a-propos: photo intro, origin and the founding question, the
// founder (no quote), why downhill, today, closing line.
// Copy: content/pages.ts (aboutPage).
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/art/PageIntro.astro";
import AboutChapters from "../components/art/AboutChapters.astro";
import FinishLine from "../components/art/FinishLine.astro";
import jumpImage from "../assets/home/louis-dh-jump.webp";
import { aboutPage } from "../content/pages.ts";
---

<BaseLayout title={aboutPage.meta.title} description={aboutPage.meta.description} overlayHeader>
  <PageIntro copy={aboutPage.intro} image={{ src: jumpImage, alt: aboutPage.imageAlt, position: "64% 42%" }} />
  <AboutChapters />
  <FinishLine title={aboutPage.finish.title} lead={aboutPage.finish.lead} />
</BaseLayout>
