---
// ART-02 — /contact: compact intro, then the real contact form (ContactForm →
// /api/contact, behaviour unchanged) next to a short aside — direct e-mail, or
// create an account. Health disclaimer kept.
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/art/PageIntro.astro";
import ContactForm from "../components/ContactForm.astro";
import { contactPage } from "../content/pages.ts";
import { home, signupHref } from "../content/home.ts";
import { siteCopy } from "../content/copy.ts";
---

<BaseLayout title={contactPage.meta.title} description={contactPage.meta.description}>
  <PageIntro copy={contactPage.intro} cta={false} />

  <section class="contact" aria-label="Formulaire de contact">
    <div class="art-wrap contact-grid">
      <div data-fade>
        <ContactForm />
      </div>

      <aside class="contact-aside" data-fade style="--fade-delay: 200ms">
        <div>
          <p class="act-label">{contactPage.aside.emailLabel}</p>
          <a href={`mailto:${contactPage.email}`} class="contact-mail">{contactPage.email}</a>
        </div>
        <div class="contact-try">
          <h2 class="contact-try-title">{contactPage.aside.tryLabel}</h2>
          <p class="contact-try-text">{contactPage.aside.tryText}</p>
          <a href={signupHref} class="btn-gold">{home.hero.primary}<span class="race-mark" aria-hidden="true"></span></a>
        </div>
      </aside>
    </div>

    <p class="art-wrap contact-disclaimer">{siteCopy.disclaimer.text}</p>
  </section>
</BaseLayout>

<style>
  .contact {
    padding-block: clamp(4rem, 3rem + 4vw, 6.5rem);
  }
  .contact-grid {
    display: grid;
    gap: 3.5rem;
  }
  @media (min-width: 960px) {
    .contact-grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      gap: clamp(3rem, 6vw, 6rem);
    }
    .contact-aside {
      padding-left: 3rem;
      border-left: 1px solid var(--color-border);
    }
  }
  .contact-aside {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }
  .contact-mail {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: clamp(1.4rem, 1.1rem + 1vw, 1.9rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    color: var(--color-text);
    word-break: break-all;
    transition: color 0.2s ease;
  }
  .contact-mail:hover {
    color: var(--color-accent);
  }
  .contact-try {
    padding-top: 2.5rem;
    border-top: 1px solid var(--color-border);
  }
  .contact-try-title {
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: -0.03em;
    color: var(--color-text);
  }
  .contact-try-text {
    margin: 0.75rem 0 1.75rem;
    max-width: 22rem;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }
  .contact-disclaimer {
    margin-top: 4.5rem;
    max-width: 48rem;
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--color-text-faint);
  }
</style>
