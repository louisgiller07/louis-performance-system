---
// V3 — same brand language as the homepage: hero, the seven coaching domains
// (docs/03_COACHING_MODEL.md) as chapters, the daily arbitration between
// them, closing CTA. Copy lives in content/pages.ts (coachingPage) and
// content/domains.ts; motion in scripts/motion.ts.
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/sections/PageHero.astro";
import DomainChapters from "../components/coaching/DomainChapters.astro";
import Arbitration from "../components/coaching/Arbitration.astro";
import FinalCta from "../components/sections/FinalCta.astro";
import { coachingPage } from "../content/pages.ts";
---

<BaseLayout title={coachingPage.meta.title} description={coachingPage.meta.description} preloadDisplayFont>
  <PageHero hero={coachingPage.hero} next="#domaines" />
  <DomainChapters />
  <Arbitration />
  <FinalCta index={coachingPage.cta.index} titleLines={coachingPage.cta.titleLines} />
</BaseLayout>

<script>
  import "../scripts/motion.ts";
</script>
