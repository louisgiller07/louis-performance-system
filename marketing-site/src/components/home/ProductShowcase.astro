---
// 05 — Le produit. The app presented as an object: one large, centred phone
// (machined frame, glass, slow float) that zooms in on arrival, very little
// text around it, four real screens (rebuilt in HTML, see AppScreen.astro)
// behind a minimal accessible tablist underneath. While the section is in
// view the tabs advance slowly on their own (gold hairline on the active
// one); the first click, or reduced motion, hands control to the visitor.
import { home } from "../../content/home.ts";
import SectionKicker from "./SectionKicker.astro";
import AppScreen from "./AppScreen.astro";

const { product } = home;
---

<section id="produit" class="product relative scroll-mt-16 overflow-hidden border-t border-border py-24 sm:py-36" data-product>
  <div class="mx-auto flex w-full max-w-7xl flex-col items-center px-6 text-center sm:px-8">
    <SectionKicker index={product.index} label={product.kicker} />
    <h2 class="mt-8 font-display text-[clamp(2.75rem,7.5vw,6rem)] font-extrabold uppercase leading-[0.9] text-text">
      <span class="block" data-reveal>{product.titleLines[0]}</span>
      <span class="block text-accent" data-reveal style="--reveal-delay: 120ms">{product.titleLines[1]}</span>
    </h2>

    <div class="relative isolate mt-16 flex w-full justify-center sm:mt-24">
      <span class="phone-glow pointer-events-none absolute left-1/2 top-[55%] -z-10 h-[70%] w-[min(46rem,120vw)] -translate-x-1/2 -translate-y-1/2" aria-hidden="true"></span>
      <div class="phone-float">
        <div class="phone relative aspect-[9/19] w-[min(21.5rem,80vw)]" data-reveal="zoom">
          <div class="phone-screen relative h-full overflow-hidden bg-bg pt-8 text-left">
            <span class="absolute left-1/2 top-3 z-10 h-[1.35rem] w-24 -translate-x-1/2 rounded-full bg-black" aria-hidden="true"></span>
            {
              product.features.map((feature, i) => (
                <div
                  role="tabpanel"
                  id={`screen-${feature.id}`}
                  aria-labelledby={`tab-${feature.id}`}
                  class:list={["screen absolute inset-0 top-8", i === 0 && "is-active"]}
                  data-screen={i}
                >
                  <AppScreen id={feature.id} />
                </div>
              ))
            }
            <span class="phone-glass pointer-events-none absolute inset-0 z-20" aria-hidden="true"></span>
          </div>
        </div>
      </div>
    </div>

    <div
      role="tablist"
      aria-label="Écrans de l'application"
      class="mt-14 grid w-full max-w-md grid-cols-2 gap-x-6 sm:mt-16 sm:flex sm:max-w-none sm:justify-center sm:gap-12"
    >
      {
        product.features.map((feature, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${feature.id}`}
            aria-controls={`screen-${feature.id}`}
            aria-selected={i === 0 ? "true" : "false"}
            tabindex={i === 0 ? 0 : -1}
            class="feature-tab relative min-h-12 py-3 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
            data-tab={i}
          >
            <span class="tab-label font-display text-xl font-extrabold uppercase leading-none tracking-wide transition-colors duration-500 sm:text-2xl">
              {feature.label}
            </span>
            <span class="absolute bottom-0 left-0 h-px w-full bg-border" aria-hidden="true" />
            <span class="tab-progress absolute bottom-0 left-0 h-px w-full origin-left bg-accent" aria-hidden="true" />
          </button>
        ))
      }
    </div>
    <div class="mt-6 min-h-[3rem]">
      {
        product.features.map((feature, i) => (
          <p class="feature-line text-base text-text-muted sm:text-lg" hidden={i !== 0} data-line={i}>
            {feature.line}
          </p>
        ))
      }
    </div>
  </div>
</section>

<style>
  .product {
    background: var(--color-bg);
  }
  .phone-glow {
    background: radial-gradient(ellipse at center, rgb(34 58 45 / 0.55), rgb(184 154 74 / 0.05) 45%, transparent 70%);
    filter: blur(10px);
  }

  /* Machined frame + side buttons + glass: an object, not a screenshot in a box. */
  .phone {
    border-radius: 3.3rem;
    padding: 0.7rem;
    background: linear-gradient(150deg, #3b3d3e 0%, #161718 20%, #0b0c0d 55%, #1d1f20 85%, #343637 100%);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.07),
      inset 0 0 0 2px rgb(0 0 0 / 0.6),
      0 90px 160px -60px rgb(0 0 0 / 0.95),
      0 40px 80px -40px rgb(0 0 0 / 0.8);
  }
  .phone::before,
  .phone::after {
    content: "";
    position: absolute;
    width: 3px;
    border-radius: 2px;
    background: linear-gradient(to bottom, #2c2e2f, #1a1b1c);
  }
  .phone::before {
    right: -3px;
    top: 24%;
    height: 11%;
  }
  .phone::after {
    left: -3px;
    top: 19%;
    height: 16%;
    box-shadow: 0 5.5rem 0 #1f2021;
  }
  .phone-screen {
    border-radius: 2.65rem;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.04);
  }
  .phone-glass {
    border-radius: inherit;
    background: linear-gradient(118deg, rgb(255 255 255 / 0.07) 0%, rgb(255 255 255 / 0.015) 32%, transparent 48%);
  }

  .feature-tab .tab-label {
    color: rgb(231 228 221 / 0.42);
  }
  .feature-tab:hover .tab-label {
    color: rgb(231 228 221 / 0.75);
  }
  .feature-tab[aria-selected="true"] .tab-label {
    color: var(--color-text);
  }
  .tab-progress {
    transform: scaleX(0);
  }
  .feature-tab[aria-selected="true"] .tab-progress {
    transform: none;
  }

  .screen {
    opacity: 0;
    visibility: hidden;
  }
  .screen.is-active {
    opacity: 1;
    visibility: visible;
  }

  @media (prefers-reduced-motion: no-preference) {
    .phone-float {
      animation: float 7s ease-in-out infinite;
    }
    :global(.js) .phone[data-reveal="zoom"] {
      transition:
        opacity 1.4s var(--ease-premium),
        transform 1.8s var(--ease-premium);
    }
    .screen {
      transform: translate3d(0, 0.75rem, 0) scale(0.985);
      transition:
        opacity 0.9s var(--ease-premium),
        transform 1.2s var(--ease-premium),
        visibility 0s linear 0.9s;
    }
    .screen.is-active {
      transform: none;
      transition:
        opacity 0.9s var(--ease-premium) 0.15s,
        transform 1.2s var(--ease-premium) 0.15s,
        visibility 0s;
    }
    /* Autoplay: the active tab's hairline fills over one cycle (duration set by the script). */
    :global([data-product].is-autoplay) .feature-tab[aria-selected="true"] .tab-progress {
      animation: tab-fill var(--cycle, 6500ms) linear both;
    }
  }

  @keyframes float {
    50% {
      transform: translate3d(0, -0.6rem, 0);
    }
  }
  @keyframes tab-fill {
    from {
      transform: scaleX(0);
    }
  }
</style>
