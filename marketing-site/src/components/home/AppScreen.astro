---
// One screen of the app, rebuilt in HTML inside the ProductShowcase phone —
// same labels and structure as the real web app (web/src: Today's "Mission
// du jour" / "Plan de séance" / "Intensité" / "Pourquoi cette décision ?",
// Programme week cards, History planned-vs-done), with the day-story values.
import type { ProductFeature } from "../../content/home.ts";
import { home } from "../../content/home.ts";

interface Props {
  id: ProductFeature["id"];
}

const { id } = Astro.props;
const { day } = home;

const week = [
  { day: "Lun", kind: "Renfo bas du corps", detail: "45 min" },
  { day: "Mar", kind: "DH technique", detail: "2 h 30", today: true },
  { day: "Mer", kind: "Récupération active", detail: "40 min" },
  { day: "Jeu", kind: "Aérobie base", detail: "1 h" },
  { day: "Ven", kind: "Entretien vélo", detail: "Activité engagée" },
  { day: "Sam", kind: "DH performance", detail: "3 h" },
  { day: "Dim", kind: "Repos", detail: "" },
];
const tabs = ["Aujourd'hui", "Programme", "Historique"];
const activeTab = id === "programme" ? 1 : id === "history" ? 2 : 0;
---

<div class="flex h-full flex-col text-[0.72rem] leading-snug text-text sm:text-[0.78rem]">
  <div class="flex items-center justify-between px-5 pb-3 pt-2 font-mono text-[0.6rem] tracking-[0.3em]">
    <span>NALYNT</span>
    <span class="text-text-muted">Mar 12</span>
  </div>
  <div class="flex gap-4 border-b border-border px-5 text-[0.65rem]">
    {
      tabs.map((tab, i) => (
        <span class:list={["pb-2", i === activeTab ? "border-b border-accent text-text" : "text-text-muted"]}>{tab}</span>
      ))
    }
  </div>

  <div class="flex flex-1 flex-col gap-3 overflow-hidden px-4 py-4">
    {
      id === "today" && (
        <>
          <p class="flex items-center gap-2 text-[0.65rem] text-text-muted">
            <span class="h-1.5 w-1.5 rounded-full bg-accent" />
            Check-in enregistré · fatigue jambes, genou sensible
          </p>
          <div class="rounded-md border border-border bg-surface p-3.5">
            <p class="text-[0.6rem] uppercase tracking-[0.18em] text-text-muted">Mission du jour</p>
            <p class="mt-1 font-display text-2xl font-extrabold uppercase leading-none">{day.session.kind}</p>
            <p class="mt-1.5 text-text-muted">{day.session.objective} · volume adapté</p>
          </div>
          <div class="rounded-md border border-border bg-surface p-3.5">
            <p class="text-[0.6rem] uppercase tracking-[0.18em] text-text-muted">Plan de séance</p>
            <ul class="mt-2 flex flex-col gap-1.5">
              <li class="flex justify-between"><span>Échauffement, lignes lentes</span><span class="font-mono text-text-muted">20 min</span></li>
              <li class="flex justify-between"><span>Runs techniques, secteurs 2–3</span><span class="font-mono text-text-muted">1 h 50</span></li>
              <li class="flex justify-between"><span>Retour au calme</span><span class="font-mono text-text-muted">20 min</span></li>
            </ul>
            <p class="mt-3 flex justify-between border-t border-border pt-2.5">
              <span class="text-text-muted">Intensité</span><span>{day.session.intensity}</span>
            </p>
          </div>
          <p class="mt-auto rounded-md border border-accent/50 py-2.5 text-center text-[0.65rem] font-semibold uppercase tracking-[0.14em] text-accent">
            Pourquoi cette décision ?
          </p>
        </>
      )
    }

    {
      id === "programme" && (
        <>
          <div class="flex items-baseline justify-between">
            <p class="font-display text-xl font-extrabold uppercase">Semaine 3</p>
            <p class="text-text-muted">Développement</p>
          </div>
          <ul class="flex flex-col gap-1.5">
            {week.map((d) => (
              <li class:list={["flex items-center justify-between rounded-md border px-3 py-2", d.today ? "border-accent/60 bg-surface" : "border-border"]}>
                <span class="flex items-center gap-3">
                  <span class="w-7 font-mono text-[0.6rem] uppercase text-text-muted">{d.day}</span>
                  <span>{d.kind}</span>
                </span>
                <span class:list={["font-mono text-[0.6rem]", d.today ? "text-accent" : "text-text-muted"]}>
                  {d.today ? "Aujourd'hui" : d.detail}
                </span>
              </li>
            ))}
          </ul>
        </>
      )
    }

    {
      id === "history" && (
        <ul class="flex flex-col gap-2">
          {day.history.map((entry) => (
            <li class="rounded-md border border-border bg-surface p-3">
              <div class="flex items-baseline justify-between">
                <span class="font-mono text-[0.6rem] uppercase text-text-muted">{entry.day}</span>
                <span class:list={["text-[0.6rem] uppercase tracking-[0.14em]", entry.tag === "Adaptée" ? "text-accent" : "text-text-muted"]}>{entry.tag}</span>
              </div>
              <p class="mt-1 text-sm">{entry.kind}</p>
              <p class="mt-0.5 font-mono text-[0.62rem] text-text-muted">{entry.detail}</p>
            </li>
          ))}
          <li class="rounded-md border border-dashed border-border p-3 text-text-muted">
            Contexte conservé : fatigue jambes et genou sensible avant séance, adaptation réalisée, résultat enregistré.
          </li>
        </ul>
      )
    }

    {
      id === "adaptation" && (
        <>
          <p class="text-[0.6rem] uppercase tracking-[0.18em] text-accent">Pourquoi cette décision ?</p>
          <div class="rounded-md border border-border bg-surface p-3.5">
            <p class="flex justify-between"><span class="text-text-muted">Séance prévue</span><span>DH technique · {day.session.plannedDuration}</span></p>
            <p class="mt-2 flex justify-between"><span class="text-text-muted">Séance du jour</span><span class="text-accent">DH technique · {day.session.duration}</span></p>
          </div>
          <div class="rounded-md border border-border bg-surface p-3.5">
            <p class="text-[0.6rem] uppercase tracking-[0.18em] text-text-muted">Raison</p>
            <p class="mt-1.5 leading-relaxed">{day.session.reason}</p>
          </div>
          <div class="rounded-md border border-border bg-surface p-3.5">
            <p class="text-[0.6rem] uppercase tracking-[0.18em] text-text-muted">Ce qui ne change pas</p>
            <p class="mt-1.5 leading-relaxed">Objectif conservé : {day.session.objective.toLowerCase()}.</p>
          </div>
        </>
      )
    }
  </div>
</div>
