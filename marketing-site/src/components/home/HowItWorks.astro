---
// 04 — Comment ça fonctionne. Three words, one loop. A gold hairline draws
// down between the pillars as they arrive — the only motion in the section.
import { home } from "../../content/home.ts";
import SectionKicker from "./SectionKicker.astro";

const { how } = home;
---

<section id="comment" class="border-t border-border bg-bg py-24 sm:py-32">
  <div class="mx-auto w-full max-w-7xl px-6 sm:px-8">
    <SectionKicker index={how.index} label={how.kicker} />

    <ol class="mt-14">
      {
        how.pillars.map((pillar, i) => (
          <li class="pillar relative grid gap-4 pb-14 pl-10 last:pb-0 sm:pl-16 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:items-end lg:gap-16 lg:pb-20" data-reveal style={`--reveal-delay: ${i * 60}ms`}>
            <span class="absolute left-0 top-3 font-mono text-xs text-accent sm:top-5" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>
            {i < how.pillars.length - 1 && (
              <span class="pillar-line absolute bottom-3 left-[0.4rem] top-10 w-px origin-top bg-accent/50 sm:top-12" aria-hidden="true" />
            )}
            <p class="font-display text-[clamp(3.5rem,12vw,9rem)] font-extrabold uppercase leading-[0.85] text-text">
              {pillar.word}
            </p>
            <div class="lg:pb-4">
              <p class="text-xl text-text sm:text-2xl">{pillar.line}</p>
              <p class="mt-2 max-w-sm text-base leading-relaxed text-text-muted">{pillar.detail}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .pillar .pillar-line {
      transform: scaleY(0);
      transition: transform 1.2s var(--ease-premium) 0.4s;
    }
    :global(.js) .pillar.is-in .pillar-line {
      transform: none;
    }
  }
</style>
