---
// ART-02.1 — /a-propos chapters, composed rather than listed:
//   origine — a "plan vs reality" map: the planned line, four real-life
//     disruptions (the four sentences), the gold route bending at each and
//     still reaching race day; then the question that changes, the old one
//     struck through by a gold line, the new one rising in gold;
//   fondateur — editorial overlap: the photo, and a rider card laid over it;
//   downhill — a full-width statement on a precision line (ideal vs ridden);
//   aujourd'hui — three milestones on a race line, the current one marked.
// Everything draws once when it enters; static without JS / reduced motion.
// Copy: content/pages.ts (aboutPage). No first-person quote.
import { Picture } from "astro:assets";
import portrait from "../../assets/home/race-performance.webp";
import { aboutPage } from "../../content/pages.ts";

const { origin, founder, downhill, today } = aboutPage;
const marks = [190, 380, 570, 760];
---

<section id="origine" class="ab-origin" aria-labelledby="origin-title">
  <div class="art-wrap">
    <h2 id="origin-title" class="art-h2 ab-origin-title" data-rise><span class="mask-line"><span>{origin.lead}</span></span></h2>

    <figure class="ab-map" data-reveal aria-label={`${origin.mapLegend.planned}, ${origin.mapLegend.actual}`}>
      <svg class="ab-map-svg" viewBox="0 0 960 150" fill="none" aria-hidden="true" focusable="false">
        <line class="ab-plan" x1="20" y1="75" x2="930" y2="75" />
        <path class="ab-real" pathLength="1" d="M 20 75 C 120 75, 150 30, 190 30 C 240 30, 300 118, 380 118 C 450 118, 500 40, 570 40 C 640 40, 690 112, 760 112 C 830 112, 880 75, 930 75" />
        {marks.map((x, k) => <circle class="ab-mark" style={`--k: ${k}`} cx={x} cy="75" r="6" />)}
        <circle class="ab-goal" cx="930" cy="75" r="12" />
        <circle class="ab-goal-core" cx="930" cy="75" r="4.5" />
      </svg>
      <p class="ab-map-legend">
        <span class="lg-plan">{origin.mapLegend.planned}</span>
        <span class="lg-real">{origin.mapLegend.actual}</span>
        <span class="lg-goal">{origin.mapLegend.goal}</span>
      </p>
      <ul class="ab-contrast">
        {origin.contrast.map((line, k) => <li style={`--k: ${k}`}>{line}</li>)}
      </ul>
    </figure>

    <div class="ab-question" data-reveal>
      <p class="ab-q-intro">{origin.questionIntro}</p>
      <p class="ab-q-old"><span>{origin.questionOld}</span></p>
      <p class="ab-q-intro">{origin.questionBridge}</p>
      <p class="ab-q-new">{origin.questionNew}</p>
    </div>
  </div>
</section>

<section id="fondateur" class="ab-founder" aria-labelledby="founder-title">
  <div class="art-wrap ab-founder-grid">
    <div class="ab-portrait" data-reveal>
      <div class="ab-portrait-media" data-parallax="0.06">
        <Picture
          src={portrait}
          formats={["avif", "webp"]}
          widths={[480, 720, 960, 1280]}
          width={1280}
          sizes="(min-width: 960px) 46vw, 100vw"
          alt={founder.imageAlt}
          loading="lazy"
        />
      </div>
    </div>
    <div class="ab-card" data-fade>
      <h2 id="founder-title" class="art-h2">{founder.title}</h2>
      {founder.text.map((p) => <p class="ab-text">{p}</p>)}
      <dl class="ab-facts">
        {
          founder.card.map(([k, v]) => (
            <div>
              <dt>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))
        }
      </dl>
      <p class="ab-name">{founder.name}</p>
      <p class="ab-role">{founder.role}</p>
    </div>
  </div>
</section>

<section id="downhill" class="ab-downhill" aria-labelledby="downhill-title">
  <div class="art-wrap">
    <h2 id="downhill-title" class="ab-dh-title" data-rise>
      <span class="mask-line"><span>{downhill.title[0]}</span></span>
      <span class="mask-line"><span>{downhill.title[1]}</span></span>
    </h2>
    <svg class="ab-precision" viewBox="0 0 960 60" fill="none" aria-hidden="true" focusable="false" data-reveal>
      <path class="ab-ideal" d="M 0 30 C 240 30, 300 14, 480 14 S 720 30, 960 30" />
      <path class="ab-ridden" pathLength="1" d="M 0 30 C 240 30, 300 14, 470 18 C 520 20, 540 44, 600 44 S 760 31, 960 31" />
      <circle class="ab-error" cx="545" cy="33" r="5" />
    </svg>
    <div class="ab-dh-body">
      {downhill.body.map((p) => <p data-fade>{p}</p>)}
    </div>
  </div>
</section>

<section id="aujourdhui" class="ab-today" aria-labelledby="today-title">
  <div class="art-wrap">
    <h2 id="today-title" class="art-h2" data-rise><span class="mask-line"><span>{today.title}</span></span></h2>
    <div class="ab-track" data-reveal>
      <span class="ab-rail" aria-hidden="true"></span>
      <ol class="ab-milestones">
        {
          today.milestones.map((m, k) => (
            <li class:list={["ab-milestone", { "is-current": m.current }]} style={`--k: ${k}`}>
              <span class="ab-dot" aria-hidden="true" />
              <p class="ab-m-label">{m.label}</p>
              <h3>{m.title}</h3>
              <p class="ab-m-body">{m.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
    <p class="ab-vision" data-fade>
      {today.vision[0]}<br />{today.vision[1]}
    </p>
  </div>
</section>

<style>
  .ab-origin,
  .ab-founder,
  .ab-downhill,
  .ab-today {
    padding-block: clamp(4rem, 3rem + 4.5vw, 7rem);
    border-bottom: 1px solid var(--color-border);
  }
  .ab-founder,
  .ab-today {
    background: #151512;
  }

  /* --- Origin: plan vs reality --- */
  .ab-origin-title {
    max-width: 34rem;
  }
  .ab-map {
    margin: 3rem 0 0;
  }
  .ab-map-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .ab-plan {
    stroke: #5f584a;
    stroke-width: 1.5;
    stroke-dasharray: 4 9;
  }
  .ab-real {
    stroke: var(--color-accent);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  .ab-mark {
    fill: var(--color-bg);
    stroke: #c9b78e;
    stroke-width: 1.5;
    transform-box: fill-box;
    transform-origin: center;
  }
  .ab-goal {
    stroke: var(--color-accent);
    stroke-width: 1.75;
    fill: var(--color-bg);
  }
  .ab-goal-core {
    fill: var(--color-accent);
  }
  .ab-map-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    color: var(--color-text-faint);
  }
  .ab-map-legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .ab-map-legend span::before {
    content: "";
    width: 1.25rem;
    height: 0;
  }
  .lg-plan::before {
    border-top: 1.5px dashed #6d6656;
  }
  .lg-real::before {
    border-top: 2px solid var(--color-accent);
  }
  .lg-goal {
    margin-left: auto;
    color: var(--color-accent);
  }
  .lg-goal::before {
    display: none;
  }
  .ab-contrast {
    display: grid;
    gap: 0.75rem 1.5rem;
    margin-top: 1.75rem;
    padding: 0;
    list-style: none;
  }
  .ab-contrast li {
    position: relative;
    padding: 0.7rem 0 0 1.4rem;
    border-top: 1px solid var(--color-border-strong);
    font-size: 1.0625rem;
    line-height: 1.45;
    color: #d6cdbb;
  }
  .ab-contrast li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 1.05rem;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    border: 1.5px solid #c9b78e;
  }
  @media (min-width: 900px) {
    .ab-contrast {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      /* The four sentences sit under their four marks (x = 190, 380, 570, 760 of 960). */
      /* pitch = 190/960 of the width: left = first mark - dot radius; right = what remains of 4 pitches. */
      margin-left: calc(190 / 960 * 100% - 0.3rem);
      margin-right: calc(10 / 960 * 100% + 1.8rem);
    }
  }

  .ab-question {
    margin-top: 4rem;
    max-width: 52rem;
  }
  .ab-q-intro {
    font-size: 1rem;
    color: var(--color-text-faint);
  }
  .ab-q-old,
  .ab-q-new {
    margin: 0.4rem 0 1.4rem;
    font-size: clamp(1.6rem, 1.15rem + 2vw, 2.9rem);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.035em;
  }
  .ab-q-old {
    color: var(--color-text-muted);
  }
  .ab-q-old span {
    position: relative;
  }
  .ab-q-old span::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 55%;
    height: 3px;
    background: var(--color-accent);
    transform-origin: left;
  }
  .ab-q-new {
    margin-bottom: 0;
    color: var(--color-accent);
  }

  /* --- Founder: photo and rider card laid over it --- */
  .ab-founder-grid {
    display: grid;
    gap: 0;
  }
  .ab-portrait {
    position: relative;
    aspect-ratio: 4 / 5;
    max-height: 70svh;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--color-border-strong);
  }
  .ab-portrait-media {
    position: absolute;
    inset: -8% 0;
    transform: translate3d(0, var(--py, 0px), 0);
  }
  .ab-portrait-media :global(picture),
  .ab-portrait-media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .ab-portrait-media :global(img) {
    object-fit: cover;
    object-position: 50% 30%;
    filter: saturate(0.7) contrast(1.04);
  }
  .ab-card {
    position: relative;
    margin: -3rem 1rem 0;
    padding: 1.75rem 1.5rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 14px;
    background: rgb(27 27 24 / 0.96);
    box-shadow: 0 40px 80px -40px rgb(0 0 0 / 0.85);
  }
  @media (min-width: 960px) {
    .ab-founder-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: center;
    }
    .ab-portrait {
      grid-column: 1 / span 6;
      grid-row: 1;
      max-height: none;
    }
    .ab-card {
      grid-column: 6 / span 7;
      grid-row: 1;
      margin: 4rem 0 0;
      padding: 2.5rem 2.75rem;
    }
  }
  .ab-text {
    margin-top: 1.1rem;
    max-width: 36rem;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-text-muted);
  }
  .ab-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem 1.5rem;
    margin: 1.75rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border-strong);
  }
  .ab-facts dt {
    font-size: 0.8125rem;
    color: var(--color-text-faint);
  }
  .ab-facts dd {
    margin: 0.15rem 0 0;
    font-size: 1rem;
    color: var(--color-text);
  }
  .ab-name {
    margin-top: 1.75rem;
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-accent);
  }
  .ab-role {
    margin-top: 0.2rem;
    font-size: 0.9375rem;
    color: var(--color-text-faint);
  }

  /* --- Downhill: a statement on a precision line --- */
  .ab-dh-title {
    max-width: 60rem;
    font-size: clamp(2rem, 1.2rem + 3.6vw, 4.25rem);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -0.045em;
    color: var(--color-text);
    text-wrap: balance;
  }
  .ab-precision {
    display: block;
    width: 100%;
    height: auto;
    margin: 2.25rem 0;
    overflow: visible;
  }
  .ab-ideal {
    stroke: #5f584a;
    stroke-width: 1.5;
    stroke-dasharray: 4 9;
  }
  .ab-ridden {
    stroke: var(--color-accent);
    stroke-width: 2.25;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  .ab-error {
    fill: var(--color-bg);
    stroke: var(--color-accent);
    stroke-width: 1.5;
    transform-box: fill-box;
    transform-origin: center;
  }
  .ab-dh-body {
    display: grid;
    gap: 1.25rem;
  }
  .ab-dh-body p {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-text-muted);
  }
  @media (min-width: 900px) {
    .ab-dh-body {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2.5rem;
    }
  }

  /* --- Today --- */
  .ab-track {
    position: relative;
    margin-top: 3rem;
    padding-left: 2rem;
  }
  .ab-milestones {
    display: grid;
    gap: 2.25rem;
    padding: 0;
    list-style: none;
  }
  .ab-rail {
    position: absolute;
    left: 0.4rem;
    top: 0.5rem;
    bottom: 0.5rem;
    border-left: 1px dashed #5b5547;
  }
  .ab-milestone {
    position: relative;
  }
  .ab-dot {
    position: absolute;
    left: calc(-2rem + 0.4rem - 0.35rem);
    top: 0.3rem;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: #5b5547;
  }
  .is-current .ab-dot {
    width: 1rem;
    height: 1rem;
    left: calc(-2rem + 0.4rem - 0.5rem);
    top: 0.15rem;
    background: var(--color-bg);
    border: 1.5px solid var(--color-accent);
    box-shadow: 0 0 0 4px rgb(213 189 134 / 0.12);
  }
  .ab-m-label {
    font-size: 0.875rem;
    color: var(--color-text-faint);
  }
  .is-current .ab-m-label {
    color: var(--color-accent);
  }
  .ab-milestone h3 {
    margin-top: 0.35rem;
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }
  .ab-m-body {
    margin-top: 0.4rem;
    max-width: 24rem;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }
  @media (min-width: 900px) {
    .ab-track {
      padding: 2.25rem 0 0;
    }
    .ab-milestones {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .ab-rail {
      left: 0;
      right: 0;
      top: 0.45rem;
      bottom: auto;
      border-left: 0;
      border-top: 1px dashed #5b5547;
    }
    .ab-dot,
    .is-current .ab-dot {
      left: 0;
      top: -2.15rem;
    }
    .is-current .ab-dot {
      top: -2.3rem;
    }
  }
  .ab-vision {
    margin-top: 3.5rem;
    max-width: 44rem;
    padding-left: 1.4rem;
    border-left: 2px solid var(--color-accent);
    font-size: clamp(1.3rem, 1.05rem + 1vw, 1.9rem);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.025em;
    color: #e2d9c6;
  }

  /* --- Draw once on entering --- */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .ab-map:not(.is-in) .ab-real,
    :global(.js) .ab-precision:not(.is-in) .ab-ridden {
      stroke-dashoffset: 1;
    }
    :global(.js) .ab-map.is-in .ab-real {
      transition: stroke-dashoffset 2s var(--ease-route) 0.2s;
    }
    :global(.js) .ab-precision.is-in .ab-ridden {
      transition: stroke-dashoffset 1.6s var(--ease-route) 0.15s;
    }
    :global(.js) .ab-map:not(.is-in) .ab-mark,
    :global(.js) .ab-precision:not(.is-in) .ab-error {
      transform: scale(0);
    }
    :global(.js) .ab-map.is-in .ab-mark {
      transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) calc(0.45s + var(--k) * 0.38s);
    }
    :global(.js) .ab-precision.is-in .ab-error {
      transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) 1.1s;
    }
    :global(.js) .ab-map:not(.is-in) .ab-contrast li {
      opacity: 0;
      transform: translate3d(0, 0.6rem, 0);
    }
    :global(.js) .ab-map.is-in .ab-contrast li {
      transition:
        opacity 0.6s var(--ease-premium) calc(0.5s + var(--k) * 0.38s),
        transform 0.6s var(--ease-premium) calc(0.5s + var(--k) * 0.38s);
    }
    :global(.js) .ab-question:not(.is-in) .ab-q-old span::after {
      transform: scaleX(0);
    }
    :global(.js) .ab-question.is-in .ab-q-old span::after {
      transition: transform 0.8s var(--ease-route) 0.5s;
    }
    :global(.js) .ab-question:not(.is-in) .ab-q-new {
      opacity: 0;
      transform: translate3d(0, 0.8rem, 0);
    }
    :global(.js) .ab-question.is-in .ab-q-new {
      transition:
        opacity 0.8s var(--ease-premium) 1.15s,
        transform 0.8s var(--ease-premium) 1.15s;
    }
    :global(.js) .ab-track:not(.is-in) .ab-milestone {
      opacity: 0;
      transform: translate3d(0, 0.8rem, 0);
    }
    :global(.js) .ab-track.is-in .ab-milestone {
      transition:
        opacity 0.7s var(--ease-premium) calc(var(--k) * 0.15s),
        transform 0.7s var(--ease-premium) calc(var(--k) * 0.15s);
    }
  }
</style>
