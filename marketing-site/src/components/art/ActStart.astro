---
// ART-02 — Act I, "Le point de départ": the rider's inputs build a week.
// Plays once when the board is well on screen (and on "Rejouer"), in the
// order of the inputs, each input lighting up as its effect lands:
//   créneaux -> the training slots open; courses -> the race drops on Sunday;
//   then the sessions settle into the slots; objectif -> the gold route runs
//   through the week to the race.
// Fictional example, labelled. No JS / reduced motion: the finished week.
import { home } from "../../content/home.ts";

const { start, acts } = home;
const sessionDays = start.days.map((d, i) => ({ ...d, i })).filter((d) => d.slot);
---

<section id="depart" class="act-start" aria-labelledby="start-title" data-act>
  <div class="art-wrap start-grid">
    <div class="start-copy">
      <p class="act-label" data-act-marker>{acts.start}</p>
      <h2 id="start-title" class="art-h2" data-rise>
        <span class="mask-line"><span>{start.title[0]}</span></span>
        <span class="mask-line"><span>{start.title[1]}</span></span>
      </h2>
      <p class="art-lead mt-5" data-fade>{start.lead}</p>

      <ul class="inputs" aria-label="Ce que tu renseignes">
        {
          start.inputs.map((input, index) => (
            <li class="input" style={`--k: ${index}`}>
              <span class="input-dot" aria-hidden="true" />
              <span class="input-label">{input.label}</span>
              <span class="input-value">{input.value}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <figure class="board" data-board>
      <figcaption class="board-head">
        <span class="board-title">{start.boardTitle}</span>
        <span class="board-tag">{start.exampleTag}</span>
        <button type="button" class="board-replay" data-board-replay>{start.replay}</button>
      </figcaption>

      <ol class="week" aria-label="Exemple de semaine">
        {
          start.days.map((d, index) => (
            <li class:list={["day", { "has-slot": d.slot, "is-race": d.race, "is-today": d.today }]} style={`--i: ${index}`}>
              <span class="day-name">{d.day}</span>
              <span class="day-cell">
                {d.today && <span class="today-tag">{start.todayLabel}</span>}
                {d.slot && <span class="slot" aria-hidden="true" />}
                {d.race && <span class="race-ring" aria-hidden="true" />}
                <span class="session">{d.session}</span>
              </span>
            </li>
          ))
        }
      </ol>

      <div class="route" aria-hidden="true">
        <span class="route-track"></span>
        <span class="route-fill"></span>
        {sessionDays.map((d) => <span class:list={["route-stop", { "is-race": d.race }]} style={`--i: ${d.i}`} />)}
      </div>

      <p class="board-note">{start.note}</p>
    </figure>
  </div>
  <div class="art-wrap bridge" data-fade>
    <span class="bridge-line" aria-hidden="true"></span>
    <p class="bridge-text">{start.bridge.text}</p>
    <a href="#demo" class="text-link">{start.bridge.link}<span class="race-mark race-mark-down" aria-hidden="true"></span></a>
  </div>
</section>

<style>
  .act-start {
    position: relative;
    padding-block: clamp(3.75rem, 2.75rem + 4vw, 6.5rem);
  }
  .start-grid {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 1024px) {
    .start-grid {
      grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
      gap: clamp(3rem, 6vw, 6.5rem);
      align-items: center;
    }
  }

  /* --- Inputs --- */
  .inputs {
    margin-top: 2.25rem;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-border);
  }
  .input {
    display: grid;
    grid-template-columns: 1rem 1fr auto;
    align-items: center;
    gap: 0.85rem;
    min-height: 3.25rem;
    border-bottom: 1px solid var(--color-border);
  }
  .input-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--color-accent);
  }
  .input-label {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }
  .input-value {
    font-size: 0.9375rem;
    color: var(--color-text);
  }

  /* --- Board --- */
  .board {
    --cols: 7;
    position: relative;
    margin: 0;
    padding: 1.4rem 1.4rem 1.2rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 14px;
    background: linear-gradient(180deg, #1d1c17, var(--color-surface) 45%);
    box-shadow: 0 40px 80px -45px rgb(0 0 0 / 0.8);
  }
  .board-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }
  .board-title {
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-text);
  }
  .board-tag {
    padding: 0.15rem 0.6rem;
    border: 1px solid var(--color-accent-deep);
    border-radius: 999px;
    font-size: 0.75rem;
    color: var(--color-accent);
  }
  .board-replay {
    margin-left: auto;
    min-height: 2.75rem;
    padding: 0 0.25rem;
    border: 0;
    background: none;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: var(--color-accent-deep);
    text-underline-offset: 0.3em;
  }
  .board-replay:hover {
    color: var(--color-accent);
  }

  .week {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }
  .day {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .day-name {
    font-size: 0.8125rem;
    color: var(--color-text-faint);
  }
  .day-cell {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 7.5rem;
    padding: 0.6rem;
    border-radius: 8px;
    background: rgb(240 238 231 / 0.025);
  }
  .slot {
    position: absolute;
    inset: 0;
    border: 1px dashed rgb(213 189 134 / 0.55);
    border-radius: 8px;
    transform-origin: bottom;
  }
  .session {
    position: relative;
    font-size: 0.8125rem;
    line-height: 1.3;
    color: var(--color-text-muted);
  }
  .has-slot .session {
    color: var(--color-text);
  }
  .race-ring {
    position: absolute;
    top: 0.65rem;
    left: 0.65rem;
    width: 1.15rem;
    height: 1.15rem;
    border-radius: 50%;
    border: 1.5px solid var(--color-accent);
  }
  .race-ring::after {
    content: "";
    position: absolute;
    inset: 0.24rem;
    border-radius: 50%;
    background: var(--color-accent);
  }
  .is-race .day-cell {
    background: rgb(213 189 134 / 0.1);
  }
  .is-race .session,
  .is-race .day-name {
    color: var(--color-accent);
  }

  /* The route through the week: track + gold fill + a stop under each session day. */
  .route {
    position: relative;
    height: 1.25rem;
    margin-top: 0.9rem;
  }
  .route-track,
  .route-fill {
    position: absolute;
    left: calc(100% / var(--cols) / 2);
    right: calc(100% / var(--cols) / 2);
    top: 50%;
  }
  .route-track {
    border-top: 1px dashed #5b5547;
  }
  .route-fill {
    height: 2px;
    margin-top: -1px;
    background: var(--color-accent);
    transform-origin: left;
  }
  .route-stop {
    position: absolute;
    top: 50%;
    left: calc((var(--i) + 0.5) * (100% / var(--cols)));
    width: 0.55rem;
    height: 0.55rem;
    margin: -0.275rem 0 0 -0.275rem;
    border-radius: 50%;
    background: var(--color-accent);
  }
  .route-stop.is-race {
    width: 0.85rem;
    height: 0.85rem;
    margin: -0.425rem 0 0 -0.425rem;
    background: var(--color-bg);
    border: 1.5px solid var(--color-accent);
  }
  .board-note {
    margin-top: 1rem;
    font-size: 0.8125rem;
    color: var(--color-text-faint);
  }

  /* Today in the week: the session the demo below re-plans. */
  .today-tag {
    position: absolute;
    top: 0.55rem;
    left: 0.6rem;
    font-size: 0.75rem;
    color: var(--color-accent);
  }
  .is-today .day-cell {
    box-shadow: inset 0 0 0 1.5px var(--color-accent);
  }
  .is-today .slot {
    border-color: transparent;
  }

  /* Bridge to Act II. */
  .bridge {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    margin-top: 2.5rem;
  }
  .bridge-line {
    width: 2.5rem;
    height: 2px;
    background: var(--color-accent);
  }
  .bridge-text {
    font-size: 1.0625rem;
    color: #e2d9c6;
  }
  :global(.race-mark-down) {
    transform: rotate(90deg);
  }
  @media (min-width: 1024px) {
    .bridge {
      justify-content: flex-end;
    }
  }

  /* Mobile: the week becomes a list of days, the route runs down the left. */
  @media (max-width: 639px) {
    .board {
      padding: 1.1rem;
    }
    .week {
      grid-template-columns: 1fr;
      gap: 0.4rem;
      padding-left: 1.6rem;
    }
    .day {
      flex-direction: row;
      align-items: center;
      gap: 0.75rem;
    }
    .day-name {
      width: 2.2rem;
      flex-shrink: 0;
    }
    .today-tag {
      position: static;
      order: 2;
      margin-left: auto;
    }
    .day-cell {
      flex: 1;
      min-height: 2.9rem;
      align-items: center;
      padding: 0.55rem 0.8rem;
    }
    .race-ring {
      position: relative;
      top: auto;
      left: auto;
      margin-right: 0.6rem;
      flex-shrink: 0;
    }
    .route {
      display: none;
    }
    /* Track, gold fill and stops, drawn on the list itself so they always line up with the days. */
    .week {
      position: relative;
    }
    .week::before,
    .week::after {
      content: "";
      position: absolute;
      left: 0.45rem;
      top: 1.45rem;
      bottom: 1.45rem;
    }
    .week::before {
      border-left: 1px dashed #5b5547;
    }
    .week::after {
      width: 2px;
      margin-left: -0.5px;
      background: var(--color-accent);
      transform-origin: top;
    }
    .day {
      position: relative;
    }
    .day.has-slot::before {
      content: "";
      position: absolute;
      left: calc(-1.6rem + 0.45rem);
      top: 50%;
      width: 0.55rem;
      height: 0.55rem;
      margin: -0.275rem 0 0 -0.275rem;
      border-radius: 50%;
      background: var(--color-accent);
      z-index: 1;
    }
    .day.is-race::before {
      width: 0.85rem;
      height: 0.85rem;
      margin: -0.425rem 0 0 -0.425rem;
      background: var(--color-bg);
      border: 1.5px solid var(--color-accent);
      box-sizing: border-box;
    }
  }

  /* --- The build sequence (plays when the board gets .is-playing) --- */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .board:not(.is-done) .slot {
      transform: scaleY(0);
      opacity: 0;
    }
    :global(.js) .board:not(.is-done) .race-ring,
    :global(.js) .board:not(.is-done) .route-stop {
      transform: scale(0);
    }
    :global(.js) .board:not(.is-done) .session {
      opacity: 0;
      transform: translate3d(0, 0.6rem, 0);
    }
    :global(.js) .board:not(.is-done) .route-fill {
      transform: scaleX(0);
    }
    :global(.js) .act-start:not(.is-done) .input-dot {
      transform: scale(0.3);
      opacity: 0.35;
    }

    :global(.js) .board.is-playing .slot {
      animation: start-slot 0.55s var(--ease-premium) calc(0.25s + var(--i) * 70ms) both;
    }
    :global(.js) .board.is-playing .race-ring {
      animation: start-drop 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) 0.95s both;
    }
    :global(.js) .board.is-playing .session {
      animation: start-session 0.55s var(--ease-premium) calc(1.35s + var(--i) * 80ms) both;
    }
    :global(.js) .board.is-playing .route-fill {
      animation: start-route-x 1.1s var(--ease-route) 2.05s both;
    }
    :global(.js) .board.is-playing .route-stop {
      animation: start-stop 0.4s var(--ease-premium) calc(2.05s + var(--i) * 150ms) both;
    }
    :global(.js) .act-start.is-playing .input-dot {
      animation: start-dot 0.5s var(--ease-premium) both;
    }
    :global(.js) .act-start.is-playing .input:nth-child(1) .input-dot {
      animation-delay: 0.15s;
    }
    :global(.js) .act-start.is-playing .input:nth-child(2) .input-dot {
      animation-delay: 0.85s;
    }
    :global(.js) .act-start.is-playing .input:nth-child(3) .input-dot {
      animation-delay: 1.95s;
    }
  }
  @media (prefers-reduced-motion: no-preference) and (max-width: 639px) {
    :global(.js) .board:not(.is-done) .week::after {
      transform: scaleY(0);
    }
    :global(.js) .board:not(.is-done) .day.has-slot::before {
      transform: scale(0);
    }
    :global(.js) .board.is-playing .week::after {
      animation: start-route-y 1.1s var(--ease-route) 2.05s both;
    }
    :global(.js) .board.is-playing .day.has-slot::before {
      animation: start-stop 0.4s var(--ease-premium) calc(2.05s + var(--i) * 150ms) both;
    }
  }
  @keyframes start-slot {
    from {
      transform: scaleY(0);
      opacity: 0;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }
  @keyframes start-drop {
    from {
      transform: translate3d(0, -1.5rem, 0) scale(0.4);
      opacity: 0;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }
  @keyframes start-session {
    from {
      opacity: 0;
      transform: translate3d(0, 0.6rem, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes start-route-x {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  @keyframes start-route-y {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }
  @keyframes start-stop {
    from {
      transform: scale(0);
    }
    to {
      transform: scale(1);
    }
  }
  @keyframes start-dot {
    from {
      transform: scale(0.3);
      opacity: 0.35;
    }
    60% {
      transform: scale(1.6);
      opacity: 1;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }
</style>

<script>
  import { reduced, whenVisible } from "../../scripts/core.ts";

  document.querySelectorAll<HTMLElement>("[data-act]").forEach((act) => {
    const board = act.querySelector<HTMLElement>("[data-board]");
    const replayButton = act.querySelector<HTMLButtonElement>("[data-board-replay]");
    if (!board) return;
    let timer = 0;
    const play = () => {
      if (reduced.matches) return;
      window.clearTimeout(timer);
      for (const el of [act, board]) {
        el.classList.remove("is-done", "is-playing");
        void el.offsetWidth;
        el.classList.add("is-playing");
      }
      timer = window.setTimeout(() => {
        for (const el of [act, board]) {
          el.classList.remove("is-playing");
          el.classList.add("is-done");
        }
      }, 3400);
    };
    if (reduced.matches) {
      act.classList.add("is-done");
      board.classList.add("is-done");
      if (replayButton) replayButton.hidden = true;
      return;
    }
    whenVisible(board, play, 0.45);
    replayButton?.addEventListener("click", play);
  });
</script>
