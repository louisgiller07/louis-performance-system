---
// ART-02 — opening of every inner page, in the homepage's language at a
// smaller scale: sentence-case title rising out of its mask, the race line
// (planned / adapted / same objective) drawing under it, optional photo
// uncovered by the start-gate blades. Plays once on load (CSS), never delays
// reading. Replaces the V3 PageHero (giant all-caps titles).
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { PageIntroCopy } from "../../content/pages.ts";
import { home, signupHref } from "../../content/home.ts";

interface Props {
  copy: PageIntroCopy;
  image?: { src: ImageMetadata; alt: string; position?: string };
  cta?: boolean;
}

const { copy, image, cta = true } = Astro.props;
---

<section class:list={["intro", { "has-image": image }]} aria-labelledby="page-title">
  {
    image && (
      <div class="intro-media">
        <div class="intro-frame" style={image.position ? `--pos: ${image.position}` : undefined}>
          <Picture
            src={image.src}
            formats={["avif", "webp"]}
            widths={[480, 720, 960, 1280, 1600]}
            width={1600}
            sizes="(min-width: 960px) 50vw, 100vw"
            alt={image.alt}
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <div class="intro-blades" aria-hidden="true">
          <span />
          <span />
        </div>
      </div>
    )
  }
  {image && <div class="intro-shade" aria-hidden="true" />}
  {
    !image && (
      <svg class="intro-art" viewBox="0 0 640 320" fill="none" aria-hidden="true" focusable="false">
        <line class="ia-plan" x1="10" y1="200" x2="600" y2="200" stroke-dasharray="4 9" />
        <path class="ia-route" pathLength="1" d="M 10 200 L 170 200 C 250 200, 270 90, 360 90 S 500 250, 600 200" />
        <circle class="ia-goal" cx="600" cy="200" r="12" />
        <circle class="ia-goal-core" cx="600" cy="200" r="4.5" />
      </svg>
    )
  }
  <div class="art-wrap intro-inner">
    <div class="intro-copy">
      <p class="act-label intro-label">{copy.label}</p>
      <h1 id="page-title" class="art-h1">
        {
          copy.titleLines.map((line, i) => (
            <span class="intro-line">
              <span style={`--d: ${120 + i * 110}ms`}>{line}</span>
            </span>
          ))
        }
      </h1>
      <svg class="intro-route" viewBox="0 0 300 40" fill="none" aria-hidden="true" focusable="false">
        <line class="ir-plan" x1="2" y1="20" x2="288" y2="20" stroke-dasharray="3 7"></line>
        <path class="ir-route" pathLength="1" d="M 2 20 L 90 20 C 120 20, 132 6, 165 6 S 230 32, 288 20"></path>
        <circle class="ir-goal" cx="288" cy="20" r="5"></circle>
      </svg>
      <p class="intro-lead">{copy.intro}</p>
      {cta && <a href={signupHref} class="btn-gold intro-cta">{home.hero.primary}<span class="race-mark" aria-hidden="true" /></a>}
    </div>
  </div>
</section>

<style>
  .intro {
    position: relative;
    isolation: isolate;
    padding-block: clamp(4.5rem, 3rem + 6vw, 8rem) clamp(4rem, 3rem + 4vw, 6.5rem);
    border-bottom: 1px solid var(--color-border);
    overflow: hidden;
  }
  .intro.has-image {
    display: flex;
    align-items: center;
    min-height: min(46rem, 88svh);
    margin-top: -4.5rem;
    padding-top: calc(4.5rem + clamp(3rem, 2rem + 4vw, 6rem));
  }
  .intro-copy {
    position: relative;
    max-width: 44rem;
  }
  .intro-line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
    margin-bottom: -0.04em;
  }
  .intro-line > span {
    display: block;
  }
  .intro-route {
    display: block;
    width: min(100%, 19rem);
    height: auto;
    margin: 1.8rem 0 1.5rem;
    overflow: visible;
  }
  .ir-plan {
    stroke: #6d6656;
    stroke-width: 1.5;
    transform-box: fill-box;
    transform-origin: left;
  }
  .ir-route {
    stroke: var(--color-accent);
    stroke-width: 2.25;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  .ir-goal {
    stroke: var(--color-accent);
    stroke-width: 1.5;
    fill: var(--color-bg);
    transform-box: fill-box;
    transform-origin: center;
  }
  .intro-lead {
    max-width: 34rem;
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.1875rem);
    line-height: 1.65;
    color: #cbc6ba;
    text-wrap: pretty;
  }
  .intro-cta {
    margin-top: 2rem;
  }

  /* Photo (A propos): right half on desktop, full bleed behind the copy on mobile. */
  .intro-media {
    position: absolute;
    inset: 0 0 0 46%;
    z-index: -1;
    overflow: hidden;
  }
  .intro-frame,
  .intro-frame :global(picture),
  .intro-frame :global(img) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }
  .intro-frame :global(img) {
    object-fit: cover;
    object-position: var(--pos, 60% 45%);
    filter: saturate(0.65) contrast(1.05);
  }
  .intro-blades span {
    position: absolute;
    top: -5%;
    bottom: -5%;
    width: 62%;
    background: var(--color-bg);
    transform: skewX(-12deg) translate3d(280%, 0, 0);
  }
  .intro-blades span:nth-child(1) {
    left: -14%;
  }
  .intro-blades span:nth-child(2) {
    left: 44%;
  }
  /* Outside the media layer, overlapping its edge by 3px: no sub-pixel seam. */
  .intro-shade {
    position: absolute;
    z-index: -1;
    inset: 0 0 0 calc(46% - 3px);
    pointer-events: none;
    background:
      linear-gradient(90deg, #11110f 0%, #11110f 3px, rgb(17 17 15 / 0.75) 18%, rgb(17 17 15 / 0.1) 70%),
      linear-gradient(0deg, #11110f 0%, transparent 30%),
      linear-gradient(180deg, rgb(17 17 15 / 0.82) 0%, rgb(17 17 15 / 0.4) 10%, transparent 24%);
  }

  /* Text-only intros: the race line, large, on the right (desktop). */
  .intro-art {
    display: none;
  }
  @media (min-width: 1200px) {
    .intro-art {
      display: block;
      position: absolute;
      right: clamp(1rem, 4vw, 4rem);
      top: 50%;
      width: min(38vw, 40rem);
      height: auto;
      transform: translate3d(0, -42%, 0);
      overflow: visible;
      pointer-events: none;
    }
  }
  .ia-plan {
    stroke: #4f493c;
    stroke-width: 1.5;
    transform-box: fill-box;
    transform-origin: left;
  }
  .ia-route {
    stroke: var(--color-accent);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    opacity: 0.85;
  }
  .ia-goal {
    stroke: var(--color-accent);
    stroke-width: 1.5;
    fill: var(--color-bg);
    transform-box: fill-box;
    transform-origin: center;
  }
  .ia-goal-core {
    fill: var(--color-accent);
    transform-box: fill-box;
    transform-origin: center;
  }
  @media (max-width: 959px) {
    .intro.has-image {
      align-items: flex-end;
      min-height: max(34rem, min(90svh, 44rem));
    }
    .intro-media {
      inset: 0;
    }
    .intro-shade {
      inset: 0;
      background:
        linear-gradient(0deg, #11110f 10%, rgb(17 17 15 / 0.8) 50%, rgb(17 17 15 / 0.3)),
        linear-gradient(180deg, rgb(17 17 15 / 0.82) 0%, rgb(17 17 15 / 0.4) 10%, transparent 24%);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .intro-blades span {
      animation: intro-blade 0.95s cubic-bezier(0.76, 0, 0.18, 1) both;
    }
    .intro-blades span:nth-child(1) {
      animation-delay: 0.1s;
    }
    .intro-frame :global(img) {
      animation: intro-arrive 1.9s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .intro-label {
      animation: intro-fade 0.7s var(--ease-premium) both;
    }
    .intro-line > span {
      animation: intro-rise 1s cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: var(--d, 0ms);
    }
    .ir-plan {
      animation: intro-plan 0.6s cubic-bezier(0.4, 0, 0.2, 1) 0.45s both;
    }
    .ir-route {
      animation: intro-draw 0.95s var(--ease-route) 0.75s both;
    }
    .ir-goal {
      animation: intro-pop 0.5s var(--ease-premium) 1.6s both;
    }
    .ia-plan {
      animation: intro-plan 0.8s cubic-bezier(0.4, 0, 0.2, 1) 0.3s both;
    }
    .ia-route {
      animation: intro-draw 1.4s var(--ease-route) 0.7s both;
    }
    .ia-goal,
    .ia-goal-core {
      animation: intro-pop 0.6s var(--ease-premium) 2s both;
    }
    .intro-lead {
      animation: intro-fade 0.8s var(--ease-premium) 0.4s both;
    }
    .intro-cta {
      animation: intro-fade 0.8s var(--ease-premium) 0.5s both;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .intro-blades {
      display: none;
    }
  }
  @keyframes intro-blade {
    from {
      transform: skewX(-12deg) translate3d(0, 0, 0);
    }
    to {
      transform: skewX(-12deg) translate3d(280%, 0, 0);
    }
  }
  @keyframes intro-arrive {
    from {
      transform: scale(1.18);
    }
    to {
      transform: none;
    }
  }
  @keyframes intro-rise {
    from {
      transform: translate3d(0, 110%, 0) skewY(5deg);
    }
    to {
      transform: none;
    }
  }
  @keyframes intro-plan {
    from {
      transform: scaleX(0);
      opacity: 0;
    }
    to {
      transform: scaleX(1);
      opacity: 1;
    }
  }
  @keyframes intro-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes intro-pop {
    from {
      transform: scale(0);
    }
    60% {
      transform: scale(1.3);
    }
    to {
      transform: scale(1);
    }
  }
  @keyframes intro-fade {
    from {
      opacity: 0;
      transform: translate3d(0, 0.8rem, 0);
    }
  }
</style>
