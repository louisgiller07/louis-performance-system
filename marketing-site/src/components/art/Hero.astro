---
// ART-02 — hero, the page's one orchestrated opening (about 2.6 s, plays once,
// never blocks reading: the headline is up by 0.8 s, the actions by 0.9 s).
//   Photo: three slanted ink blades open like a start gate, the rider arrives
//   in depth (short scale + drift, 1.3 s), a gold light passes once.
//   Line: the planned route draws (dashed); at the "état du jour" mark the gold
//   route leaves it, a rider dot rides it, and it reaches the same objective,
//   which pulses once.
//   Interface (>= 960px): a race-control card, linked to the rider by a gold
//   leader line, shows the adjusted session (fictional example).
// Depth after the opening: the photo drifts with the scroll and leans away
// from fine pointers; the copy rises a little faster (src/scripts/home.ts).
// Reduced motion: final state, no drift. No JS: everything visible, card hidden.
import { Picture } from "astro:assets";
import heroImage from "../../assets/home/race-performance.webp";
import { home, signupHref } from "../../content/home.ts";

const { hero } = home;
const route = "M 3 36 L 150 36 C 196 36, 214 12, 262 12 S 352 60, 440 36";
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="hero-media" data-hero-media>
    <div class="hero-frame" data-hero-frame>
      <Picture
        src={heroImage}
        formats={["avif", "webp"]}
        widths={[480, 720, 960, 1280, 1600]}
        width={1600}
        sizes="(min-width: 960px) 62vw, 100vw"
        alt={hero.imageAlt}
        loading="eager"
        fetchpriority="high"
        quality={42}
        class="hero-img"
      />
    </div>
    <div class="hero-shutter" aria-hidden="true"><span></span><span></span><span></span></div>
    <span class="hero-flare" aria-hidden="true"></span>
  </div>
  <div class="hero-shade" aria-hidden="true"></div>

  <div class="telemetry" aria-hidden="true" data-telemetry>
    <svg class="telemetry-lead" data-telemetry-svg><path pathLength="1" d="M0 0" data-telemetry-path></path></svg>
    <span class="telemetry-anchor"></span>
    <div class="telemetry-card" data-telemetry-card>
      <p class="tm-head"><span class="tm-brand">NALYNT</span><span>{hero.telemetry.head}</span></p>
      {
        hero.telemetry.rows.map(([label, value]) => (
          <p class="tm-row">
            <span>{label}</span>
            <span>{value}</span>
          </p>
        ))
      }
      <p class="tm-change">
        <span class="tm-from">{hero.telemetry.from}</span>
        <span class="tm-arrow"></span>
        <b>{hero.telemetry.to}</b>
      </p>
      <p class="tm-status">{hero.telemetry.status}</p>
    </div>
  </div>

  <div class="art-wrap hero-inner">
    <div class="hero-copy">
      <h1 id="hero-title" class="hero-title">
        <span class="hero-line"><span style="--d: 140ms">{hero.titleLines[0]}</span></span>
        <span class="hero-line"><span style="--d: 260ms">{hero.titleLines[1]}</span></span>
      </h1>

      <div class="story" aria-hidden="true">
        <svg class="story-svg" viewBox="0 0 452 72" fill="none" focusable="false">
          <g class="story-plan"><line x1="3" y1="36" x2="440" y2="36" stroke-dasharray="3 7"></line></g>
          <g class="story-tick"><line x1="150" y1="27" x2="150" y2="45"></line></g>
          <path id="hero-route" class="story-route" pathLength="1" d={route}></path>
          <circle class="story-pulse" cx="440" cy="36" r="7"></circle>
          <circle class="story-goal" cx="440" cy="36" r="7"></circle>
          <circle class="story-goal-core" cx="440" cy="36" r="2.6"></circle>
          <circle class="story-rider" r="3.6" cx="3" cy="36" data-story-rider></circle>
        </svg>
        <span class="story-label story-label-change">{hero.lineLabels.change}</span>
        <span class="story-label story-label-goal">{hero.lineLabels.goal}</span>
      </div>

      <p class="hero-lead">{hero.lead}</p>

      <div class="hero-actions">
        <a href={signupHref} class="btn-gold">{hero.primary}<span class="race-mark" aria-hidden="true"></span></a>
        <a href="#demo" class="text-link">{hero.secondary}</a>
      </div>
    </div>
  </div>

  <p class="hero-credit"><span aria-hidden="true"></span>{hero.credit}</p>
</section>

<style>
  .hero {
    --py: 0px;
    --tx: 0px;
    --ty: 0px;
    --hy: 0px;
    --hfade: 1;
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    min-height: max(40rem, min(100svh, 58rem));
    margin-top: -4.5rem;
    padding-top: 4.5rem;
    overflow: hidden;
  }

  /* --- Photo --- */
  .hero-media {
    position: absolute;
    inset: 0 0 0 38%;
    z-index: -1;
    overflow: hidden;
    transform: translate3d(0, var(--py), 0);
    will-change: transform;
    contain: paint;
  }
  .hero-frame {
    position: absolute;
    inset: -2.5%;
    transform: translate3d(var(--tx), var(--ty), 0);
    transition: transform 0.9s var(--ease-premium);
  }
  .hero-frame :global(picture),
  .hero-frame :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hero-frame :global(img) {
    object-fit: cover;
    object-position: 50% 28%;
    filter: saturate(0.72) contrast(1.05);
    transform-origin: 46% 40%;
    /* Own layer: the arrival scale is composited, not re-rasterised each frame. */
    will-change: transform;
  }
  .hero-shutter {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .hero-shutter span {
    position: absolute;
    top: -5%;
    bottom: -5%;
    width: 42%;
    background: var(--color-bg);
    transform: skewX(-12deg) translate3d(340%, 0, 0);
    will-change: transform;
  }
  .hero-shutter span:nth-child(1) {
    left: -12%;
  }
  .hero-shutter span:nth-child(2) {
    left: 26%;
  }
  .hero-shutter span:nth-child(3) {
    left: 64%;
  }
  .hero-flare {
    position: absolute;
    top: -10%;
    bottom: -10%;
    left: 0;
    width: 32%;
    /* Plain alpha (no blend mode): much cheaper to composite in every engine. */
    background: linear-gradient(90deg, transparent, rgb(255 230 185 / 0.16), transparent);
    opacity: 0;
    will-change: transform, opacity;
    transform: skewX(-12deg) translate3d(-140%, 0, 0);
    pointer-events: none;
  }
  /* Outside the moving media layer, overlapping its edge by 3px: no sub-pixel seam. */
  .hero-shade {
    position: absolute;
    inset: 0 0 0 calc(38% - 3px);
    z-index: -1;
    pointer-events: none;
    background:
      linear-gradient(90deg, #11110f 0%, #11110f 3px, rgb(17 17 15 / 0.92) 12%, rgb(17 17 15 / 0.62) 30%, rgb(17 17 15 / 0.08) 72%),
      linear-gradient(0deg, #11110f 0%, transparent 24%),
      linear-gradient(180deg, rgb(17 17 15 / 0.78) 0%, rgb(17 17 15 / 0.35) 9%, transparent 20%);
  }

  /* --- Race-control card (desktop, positioned by script) --- */
  .telemetry {
    display: none;
  }
  @media (min-width: 960px) {
    :global(.js) .telemetry {
      display: block;
      position: absolute;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      transform: translate3d(var(--tx), calc(var(--py) + var(--ty)), 0);
      transition: transform 0.9s var(--ease-premium);
    }
  }
  .telemetry-lead {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .telemetry-lead path {
    stroke: var(--color-accent);
    stroke-width: 1.25;
    fill: none;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  .telemetry-anchor {
    position: absolute;
    left: var(--ax, -100px);
    top: var(--ay, -100px);
    width: 0.9rem;
    height: 0.9rem;
    margin: -0.45rem 0 0 -0.45rem;
    border-radius: 50%;
    border: 1.5px solid var(--color-accent);
  }
  .telemetry-anchor::after {
    content: "";
    position: absolute;
    inset: 0.18rem;
    border-radius: 50%;
    background: var(--color-accent);
  }
  .telemetry-card {
    position: absolute;
    left: var(--kx, -400px);
    top: var(--ky, -400px);
    width: 14.5rem;
    padding: 0.85rem 1rem 0.9rem;
    border: 1px solid rgb(213 189 134 / 0.45);
    border-radius: 10px;
    background: rgb(17 17 15 / 0.84);
    box-shadow: 0 24px 50px -24px rgb(0 0 0 / 0.8);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }
  .tm-head {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.55rem;
    font-size: 0.75rem;
    color: var(--color-text-faint);
  }
  .tm-brand {
    font-weight: 700;
    letter-spacing: -0.04em;
    color: var(--color-text);
  }
  .tm-row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.3rem 0;
    border-top: 1px solid rgb(240 238 231 / 0.08);
  }
  .tm-row span:last-child {
    color: var(--color-text);
  }
  .tm-change {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    margin-top: 0.55rem;
    font-variant-numeric: tabular-nums;
  }
  .tm-from {
    color: var(--color-text-faint);
    text-decoration: line-through;
    text-decoration-color: rgb(213 189 134 / 0.6);
  }
  .tm-arrow {
    width: 1.1rem;
    height: 1px;
    background: var(--color-accent);
    align-self: center;
  }
  .tm-change b {
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--color-accent);
  }
  .tm-status {
    margin-top: 0.15rem;
    color: #cdb98d;
  }

  /* --- Copy --- */
  .hero-inner {
    position: relative;
  }
  .hero-copy {
    max-width: 40rem;
    padding-block: 3.5rem 4.5rem;
    transform: translate3d(0, var(--hy), 0);
    opacity: var(--hfade);
  }
  .hero-title {
    font-size: clamp(2.5rem, 1.3rem + 3.9vw, 4.25rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.045em;
    color: var(--color-text);
  }
  .hero-line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.1em;
    margin-bottom: -0.04em;
  }
  .hero-line > span {
    display: block;
    transform-origin: left bottom;
  }

  .story {
    position: relative;
    width: min(100%, 28rem);
    margin: 2rem 0 1.6rem;
  }
  .story-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .story-plan line {
    stroke: #6d6656;
    stroke-width: 1.5;
  }
  .story-plan,
  .story-tick,
  .story-goal,
  .story-goal-core,
  .story-pulse {
    transform-box: fill-box;
  }
  .story-plan {
    transform-origin: left center;
  }
  .story-tick line {
    stroke: #a8946a;
    stroke-width: 1.5;
  }
  .story-tick {
    transform-origin: center;
  }
  .story-route {
    stroke: var(--color-accent);
    stroke-width: 2.25;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  .story-goal {
    stroke: var(--color-accent);
    stroke-width: 1.5;
    fill: var(--color-bg);
    transform-origin: center;
  }
  .story-goal-core {
    fill: var(--color-accent);
    transform-origin: center;
  }
  .story-pulse {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1;
    opacity: 0;
    transform-origin: center;
  }
  .story-rider {
    fill: var(--color-text);
    stroke: var(--color-bg);
    stroke-width: 2;
    opacity: 0;
  }
  /* Line labels: readable on the photo (size, contrast, soft halo); the goal label ends
     under the ring, so it never reaches the screen edge. They only fade: no movement. */
  .story-label {
    position: absolute;
    font-size: 0.8125rem;
    font-weight: 500;
    white-space: nowrap;
    text-shadow:
      0 1px 2px rgb(17 17 15 / 0.95),
      0 0 10px rgb(17 17 15 / 0.85);
  }
  .story-label-change {
    left: calc(150 / 452 * 100%);
    top: 0;
    color: #ddd1b4;
    transform: translate3d(-50%, -118%, 0);
  }
  .story-label-goal {
    left: calc(447 / 452 * 100%);
    bottom: 0;
    color: var(--color-accent);
    transform: translate3d(-100%, 108%, 0);
  }

  .hero-lead {
    max-width: 30rem;
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.125rem);
    line-height: 1.65;
    color: #cbc6ba;
    text-wrap: pretty;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 2rem;
  }

  .hero-credit {
    position: absolute;
    right: clamp(1.25rem, 3vw, 3rem);
    bottom: 1.75rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.8125rem;
    color: #d7d2c5;
  }
  .hero-credit span {
    width: 1rem;
    height: 1px;
    background: var(--color-accent);
  }

  /* Mobile and tablet: the photo is a band at the top, framed on the rider; the title starts
     in its faded bottom edge, so it never covers the rider and the actions stay in the first
     screen even on a 667px-high phone. */
  @media (max-width: 959px) {
    .hero {
      --photo-h: clamp(18rem, 56svh, 27rem);
      display: block;
      min-height: 0;
      padding-top: 0;
    }
    .hero-media {
      inset: 0 0 auto 0;
      height: var(--photo-h);
    }
    /* Covers the band's fractional bottom edge by 3px: no sub-pixel seam. */
    .hero-shade {
      inset: 0 0 auto 0;
      height: calc(var(--photo-h) + 3px);
    }
    .hero-frame :global(img) {
      object-position: 58% 2%;
    }
    .hero-shade {
      background:
        linear-gradient(0deg, #11110f 0%, #11110f 7px, rgb(17 17 15 / 0.8) 24%, rgb(17 17 15 / 0.15) 58%, transparent 72%),
        linear-gradient(180deg, rgb(17 17 15 / 0.8) 0%, rgb(17 17 15 / 0.35) 14%, transparent 26%);
    }
    .hero-inner {
      padding-top: calc(var(--photo-h) - 5.5rem);
    }
    .hero-copy {
      padding-block: 0 2.5rem;
    }
    .story {
      margin: 1.5rem 0 1.25rem;
    }
    .hero-credit {
      display: none;
    }
  }

  /* --- The opening --- */
  @media (prefers-reduced-motion: no-preference) {
    .hero-shutter span {
      animation: hero-blade 0.95s cubic-bezier(0.76, 0, 0.18, 1) both;
    }
    .hero-shutter span:nth-child(1) {
      animation-delay: 0.16s;
    }
    .hero-shutter span:nth-child(2) {
      animation-delay: 0.08s;
    }
    .hero-flare {
      animation: hero-flare 1.4s cubic-bezier(0.45, 0, 0.25, 1) 0.55s both;
    }
    .hero-frame :global(img) {
      animation: hero-arrive 1.3s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .hero-line > span {
      animation: hero-rise 1.05s cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: var(--d, 0ms);
    }
    .story-plan {
      animation: hero-plan 0.65s cubic-bezier(0.4, 0, 0.2, 1) 0.55s both;
    }
    .story-tick {
      animation: hero-tick 0.45s var(--ease-premium) 1.05s both;
    }
    .story-route {
      animation: hero-draw 1.1s var(--ease-route) 1.2s both;
    }
    .story-rider {
      animation: hero-dot 1.35s linear 1.2s both;
    }
    .story-goal {
      animation: hero-pop 0.6s var(--ease-premium) 2.2s both;
    }
    .story-goal-core {
      animation: hero-pop 0.6s var(--ease-premium) 2.3s both;
    }
    .story-pulse {
      animation: hero-pulse 1.1s ease-out 2.3s both;
    }
    .story-label-change {
      animation: hero-label 0.5s var(--ease-premium) 1.1s both;
    }
    .story-label-goal {
      animation: hero-label 0.5s var(--ease-premium) 2.3s both;
    }
    .hero-lead {
      animation: hero-fade 0.8s var(--ease-premium) 0.42s both;
    }
    .hero-actions {
      animation: hero-fade 0.8s var(--ease-premium) 0.52s both;
    }
    .hero-credit {
      animation: hero-fade 0.9s var(--ease-premium) 1.3s both;
    }
    :global(.js) .telemetry-lead path {
      animation: hero-draw 0.7s var(--ease-route) 1.55s both;
    }
    :global(.js) .telemetry-anchor {
      animation: hero-pop 0.55s var(--ease-premium) 1.45s both;
    }
    :global(.js) .telemetry-card {
      animation: hero-card 0.75s var(--ease-premium) 2.05s both;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-shutter,
    .hero-flare,
    .story-rider {
      display: none;
    }
  }
  :global(html:not(.js)) .story-rider {
    display: none;
  }
  @keyframes hero-blade {
    from {
      transform: skewX(-12deg) translate3d(0, 0, 0);
    }
    to {
      transform: skewX(-12deg) translate3d(340%, 0, 0);
    }
  }
  @keyframes hero-flare {
    0% {
      opacity: 0;
      transform: skewX(-12deg) translate3d(-140%, 0, 0);
    }
    25% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: skewX(-12deg) translate3d(380%, 0, 0);
    }
  }
  /* Short and moderate on purpose: a big photo scaling is the costliest frame work of the
     opening in software-rendered engines (measured in WebKit / Firefox, ART-02.1). */
  @keyframes hero-arrive {
    from {
      transform: scale(1.12) translate3d(-1.5%, -2%, 0);
    }
    to {
      transform: none;
    }
  }
  @keyframes hero-rise {
    from {
      transform: translate3d(0, 110%, 0) skewY(5deg);
    }
    to {
      transform: none;
    }
  }
  @keyframes hero-plan {
    from {
      transform: scaleX(0);
      opacity: 0;
    }
    to {
      transform: scaleX(1);
      opacity: 1;
    }
  }
  @keyframes hero-tick {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }
  @keyframes hero-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes hero-dot {
    0% {
      opacity: 0;
    }
    8% {
      opacity: 1;
    }
    80% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
  @keyframes hero-pop {
    from {
      transform: scale(0);
      opacity: 0;
    }
    60% {
      transform: scale(1.25);
      opacity: 1;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }
  @keyframes hero-pulse {
    0% {
      transform: scale(1);
      opacity: 0;
    }
    2% {
      opacity: 0.7;
    }
    100% {
      transform: scale(3);
      opacity: 0;
    }
  }
  @keyframes hero-label {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes hero-fade {
    from {
      opacity: 0;
      transform: translate3d(0, 1rem, 0);
    }
  }
  @keyframes hero-card {
    from {
      opacity: 0;
      transform: translate3d(0.75rem, 0.5rem, 0) scale(0.97);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  import { finePointer, onScrollFrame, reduced, rideAlong } from "../../scripts/core.ts";

  const hero = document.querySelector<HTMLElement>("[data-hero]");
  const media = hero?.querySelector<HTMLElement>("[data-hero-media]");
  const frame = hero?.querySelector<HTMLElement>("[data-hero-frame]");
  const img = frame?.querySelector<HTMLImageElement>("img");
  const telemetry = hero?.querySelector<HTMLElement>("[data-telemetry]");
  const card = hero?.querySelector<HTMLElement>("[data-telemetry-card]");
  const leader = hero?.querySelector<SVGPathElement>("[data-telemetry-path]");

  /** Where the rider's handlebar sits in the photo (fraction of the original image). */
  const RIDER = { x: 0.5, y: 0.35 };

  // Race-control card: anchored on the rider through the real cover crop of the photo
  // (object-fit / object-position), computed from layout boxes, so it ignores the opening animation.
  const placeTelemetry = () => {
    if (!hero || !media || !frame || !img || !telemetry || !card || !leader) return;
    if (window.innerWidth < 960) return;
    const natW = img.naturalWidth || Number(img.getAttribute("width")) || 1;
    const natH = img.naturalHeight || Number(img.getAttribute("height")) || 1;
    const boxW = frame.offsetWidth;
    const boxH = frame.offsetHeight;
    const scale = Math.max(boxW / natW, boxH / natH);
    const [posX, posY] = getComputedStyle(img)
      .objectPosition.split(" ")
      .map((v) => parseFloat(v) / 100);
    const ax = media.offsetLeft + frame.offsetLeft + (boxW - natW * scale) * (posX ?? 0.5) + RIDER.x * natW * scale;
    const ay = media.offsetTop + frame.offsetTop + (boxH - natH * scale) * (posY ?? 0.5) + RIDER.y * natH * scale;
    const heroW = hero.clientWidth;
    const heroH = hero.clientHeight;
    const kx = Math.min(ax + heroW * 0.1, heroW - card.offsetWidth - 40);
    const ky = Math.min(ay + heroH * 0.16, heroH - card.offsetHeight - 96);
    telemetry.style.setProperty("--ax", `${ax.toFixed(1)}px`);
    telemetry.style.setProperty("--ay", `${ay.toFixed(1)}px`);
    telemetry.style.setProperty("--kx", `${kx.toFixed(1)}px`);
    telemetry.style.setProperty("--ky", `${ky.toFixed(1)}px`);
    const ly = ky + 22;
    leader.setAttribute("d", `M ${(ax + 7).toFixed(1)} ${(ay + 7).toFixed(1)} L ${(kx - 22).toFixed(1)} ${ly.toFixed(1)} L ${kx.toFixed(1)} ${ly.toFixed(1)}`);
  };
  // The rider dot rides the gold route, in step with its drawing (CSS: 1.2 s delay, 1.1 s).
  const storyRider = hero?.querySelector<SVGCircleElement>("[data-story-rider]");
  const storyRoute = hero?.querySelector<SVGPathElement>(".story-route");
  if (storyRider && storyRoute) {
    const easeRoute = (t: number) => {
      // cubic-bezier(0.55, 0, 0.25, 1), solved for x by bisection
      const bez = (a: number, b: number, s: number) => 3 * a * s * (1 - s) ** 2 + 3 * b * s * s * (1 - s) + s ** 3;
      let lo = 0;
      let hi = 1;
      for (let i = 0; i < 20; i++) {
        const mid = (lo + hi) / 2;
        if (bez(0.55, 0.25, mid) < t) lo = mid;
        else hi = mid;
      }
      return bez(0, 1, (lo + hi) / 2);
    };
    rideAlong(storyRider, storyRoute, 1100, 1200, easeRoute);
  }

  if (img?.complete) placeTelemetry();
  else img?.addEventListener("load", placeTelemetry, { once: true });
  placeTelemetry();
  window.addEventListener("resize", placeTelemetry, { passive: true });

  if (hero && !reduced.matches) {
    // Depth with the scroll: the photo drifts slower, the copy rises a little faster and fades.
    onScrollFrame(hero, () => {
      const rect = hero.getBoundingClientRect();
      const y = Math.max(0, -rect.top);
      hero.style.setProperty("--py", `${(y * 0.18).toFixed(1)}px`);
      hero.style.setProperty("--hy", `${(-y * 0.1).toFixed(1)}px`);
      hero.style.setProperty("--hfade", (1 - Math.min(1, y / (rect.height * 0.9)) * 0.6).toFixed(3));
    });
    // Depth with the pointer (fine pointers only): the photo leans away from the cursor.
    if (finePointer.matches) {
      hero.addEventListener("pointermove", (event) => {
        const rect = hero.getBoundingClientRect();
        const nx = (event.clientX - rect.left) / rect.width - 0.5;
        const ny = (event.clientY - rect.top) / rect.height - 0.5;
        hero.style.setProperty("--tx", `${(-nx * 16).toFixed(1)}px`);
        hero.style.setProperty("--ty", `${(-ny * 10).toFixed(1)}px`);
      });
      hero.addEventListener("pointerleave", () => {
        hero.style.setProperty("--tx", "0px");
        hero.style.setProperty("--ty", "0px");
      });
    }
  }
</script>
