---
// ART-02.1 — /comment-ca-marche: the daily loop as a zigzag story. Each step
// pairs its text with a small fictional app screen (week, check-in, decision,
// history), all on one gold line that fills with the scroll and closes back
// on itself at the end ("et demain, la boucle repart"). Each screen plays its
// one small change when it enters (bars fill, the decision lands on "Ajuster",
// rows settle). Mobile: text then screen, line down the left. Static and
// complete without JS / with reduced motion. Values are an example, labelled.
import { howPage } from "../../content/pages.ts";

const { loop } = howPage;
const d = loop.decision;
---

<section id="boucle" class="loop" aria-labelledby="loop-title">
  <div class="art-wrap">
    <div class="loop-head">
      <h2 id="loop-title" class="art-h2" data-rise>
        <span class="mask-line"><span>{loop.title[0]}</span></span>
        <span class="mask-line"><span>{loop.title[1]}</span></span>
      </h2>
      <p class="loop-aside" data-fade>{loop.aside}</p>
    </div>

    <div class="loop-track" data-loop style="--p: 0">
      <span class="loop-rail" aria-hidden="true"><span class="loop-fill"></span></span>
      <ol class="loop-steps">
        {
          loop.steps.map((step, index) => (
            <li class:list={["loop-step", { "is-flip": index % 2 === 1 }]} data-reveal>
              <div class="loop-text">
                <span class="loop-node" aria-hidden="true" />
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </div>
              <figure class="screen" aria-label={`${step.title} : ${loop.exampleTag.toLowerCase()}`}>
                <p class="screen-tag">{loop.exampleTag}</p>
                {index === 0 && (
                  <ol class="sc-week">
                    {loop.week.map(([day, session], k) => (
                      <li class:list={{ "is-race": k === 6, "is-today": k === 1, "is-rest": k === 2 }} style={`--k: ${k}`}>
                        <span>{day}</span>
                        <b>{session}</b>
                      </li>
                    ))}
                  </ol>
                )}
                {index === 1 && (
                  <ul class="sc-checkin">
                    {loop.checkin.map((row, k) => (
                      <li class:list={{ "is-key": row.key }} style={`--k: ${k}; --level: ${row.level}`}>
                        <span>{row.label}</span>
                        <span>{row.value}</span>
                        <i aria-hidden="true">
                          <i />
                        </i>
                      </li>
                    ))}
                  </ul>
                )}
                {index === 2 && (
                  <div class="sc-decision">
                    <p class="sc-options" style={`--chosen: ${d.chosen}`}>
                      <span class="sc-chosen" aria-hidden="true" />
                      {d.options.map((o, k) => (
                        <span class:list={{ "is-chosen": k === d.chosen }}>{o}</span>
                      ))}
                    </p>
                    <p class="sc-session">
                      <span>{d.session}</span>
                      <span class="sc-change">
                        <s>{d.from}</s> <b>{d.to}</b>
                      </span>
                    </p>
                    <p class="sc-reason">{d.reason}</p>
                  </div>
                )}
                {index === 3 && (
                  <ul class="sc-history">
                    {loop.history.map((row, k) => (
                      <li style={`--k: ${k}`}>
                        <p>
                          <span>{row.session}</span>
                          <span>{row.day}</span>
                        </p>
                        <small>{row.detail}</small>
                      </li>
                    ))}
                  </ul>
                )}
              </figure>
            </li>
          ))
        }
      </ol>
      <div class="loop-close" data-reveal>
        <svg class="loop-return" viewBox="0 0 120 80" fill="none" aria-hidden="true" focusable="false">
          <path pathLength="1" d="M 60 0 C 60 50, 110 60, 110 30 C 110 8, 80 6, 72 18" />
        </svg>
        <p>{loop.closing}</p>
      </div>
    </div>
  </div>
</section>

<script>
  import { clamp01, onScrollFrame } from "../../scripts/core.ts";

  document.querySelectorAll<HTMLElement>("[data-loop]").forEach((track) => {
    onScrollFrame(track, () => {
      const rect = track.getBoundingClientRect();
      const p = clamp01((window.innerHeight * 0.6 - rect.top) / rect.height);
      track.style.setProperty("--p", p.toFixed(4));
    });
  });
</script>

<style>
  .loop {
    padding-block: clamp(4rem, 3rem + 4vw, 7rem);
    background: #151512;
    border-block: 1px solid var(--color-border);
  }
  .loop-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem 3rem;
  }
  .loop-aside {
    font-size: 1rem;
    color: var(--color-text-muted);
  }

  /* --- The line: down the left on mobile, down the middle on desktop --- */
  .loop-track {
    --x: 0.45rem;
    position: relative;
    margin-top: 3rem;
  }
  .loop-rail {
    position: absolute;
    left: var(--x);
    top: 0.6rem;
    bottom: 3.5rem;
    border-left: 1px dashed #5b5547;
  }
  .loop-fill {
    position: absolute;
    left: -1.5px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--color-accent);
    transform-origin: top;
    transform: scaleY(var(--p));
  }
  .loop-steps {
    display: grid;
    gap: 3.5rem;
    padding: 0;
    list-style: none;
  }
  .loop-step {
    display: grid;
    gap: 1.5rem;
    padding-left: 2rem;
  }
  .loop-text {
    position: relative;
  }
  .loop-node {
    position: absolute;
    left: calc(-2rem + var(--x) - 0.45rem);
    top: 0.35rem;
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 50%;
    border: 1.5px solid var(--color-accent);
    background: #151512;
  }
  .loop-text h3 {
    font-size: clamp(1.35rem, 1.1rem + 1vw, 1.9rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    color: var(--color-text);
  }
  .loop-text p {
    margin-top: 0.6rem;
    max-width: 26rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }
  @media (min-width: 900px) {
    .loop-track {
      --x: 50%;
    }
    .loop-rail {
      margin-left: -0.5px;
    }
    .loop-steps {
      gap: 4.5rem;
    }
    .loop-step {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: 6rem;
      align-items: center;
      padding-left: 0;
    }
    .loop-text {
      text-align: right;
      justify-self: end;
    }
    .loop-text p {
      margin-left: auto;
    }
    .loop-node {
      left: auto;
      right: calc(-3rem - 0.45rem);
    }
    .is-flip .loop-text {
      order: 2;
      text-align: left;
      justify-self: start;
    }
    .is-flip .loop-text p {
      margin-left: 0;
    }
    .is-flip .loop-node {
      right: auto;
      left: calc(-3rem - 0.45rem);
    }
    .is-flip .screen {
      justify-self: end;
    }
  }
  .loop-step.is-in .loop-node,
  :global(html:not(.js)) .loop-node {
    background: var(--color-accent);
  }

  /* --- Mini screens --- */
  .screen {
    width: min(100%, 24rem);
    margin: 0;
    padding: 1.1rem 1.2rem 1.2rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 12px;
    background: linear-gradient(180deg, #1e1d19, var(--color-surface) 45%);
    box-shadow: 0 30px 60px -35px rgb(0 0 0 / 0.8);
  }
  .screen-tag {
    display: inline-block;
    margin-bottom: 0.9rem;
    padding: 0.12rem 0.55rem;
    border: 1px solid var(--color-accent-deep);
    border-radius: 999px;
    font-size: 0.75rem;
    color: var(--color-accent);
  }
  .sc-week {
    display: grid;
    gap: 0.3rem;
    padding: 0;
    list-style: none;
  }
  .sc-week li {
    display: grid;
    grid-template-columns: 2.6rem 1fr;
    align-items: center;
    min-height: 2rem;
    padding: 0.3rem 0.6rem;
    border-radius: 6px;
    background: rgb(240 238 231 / 0.04);
    font-size: 0.8125rem;
    color: var(--color-text-faint);
  }
  .sc-week b {
    font-weight: 500;
    color: var(--color-text);
  }
  .sc-week .is-rest b {
    font-weight: 400;
    color: var(--color-text-muted);
  }
  .sc-week .is-today {
    box-shadow: inset 0 0 0 1.5px var(--color-accent);
  }
  .sc-week .is-race {
    background: rgb(213 189 134 / 0.14);
  }
  .sc-week .is-race b,
  .sc-week .is-race span {
    color: var(--color-accent);
  }

  .sc-checkin {
    display: grid;
    gap: 0.75rem;
    padding: 0;
    list-style: none;
  }
  .sc-checkin li {
    display: grid;
    grid-template-columns: 1fr auto;
    row-gap: 0.35rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }
  .sc-checkin li span:nth-child(2) {
    color: var(--color-text);
  }
  .sc-checkin li > i {
    grid-column: 1 / -1;
    position: relative;
    height: 4px;
    border-radius: 2px;
    background: rgb(240 238 231 / 0.07);
    overflow: hidden;
  }
  .sc-checkin li > i > i {
    position: absolute;
    inset: 0;
    background: #8f7a51;
    transform-origin: left;
    transform: scaleX(var(--level));
  }
  .sc-checkin .is-key > i > i {
    background: var(--color-accent);
  }
  .sc-checkin .is-key span {
    color: var(--color-accent);
  }

  .sc-options {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    padding: 0.25rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: 0.8125rem;
    text-align: center;
  }
  .sc-options span:not(.sc-chosen) {
    position: relative;
    padding: 0.4rem 0;
    color: var(--color-text-muted);
    transition: color 0.3s ease;
  }
  .sc-options .is-chosen {
    color: #1f1c14 !important;
    font-weight: 600;
  }
  .sc-chosen {
    position: absolute;
    top: 0.25rem;
    bottom: 0.25rem;
    left: 0.25rem;
    width: calc((100% - 0.5rem) / 3);
    border-radius: 999px;
    background: var(--color-accent);
    transform: translate3d(calc(var(--chosen) * 100%), 0, 0);
  }
  .sc-session {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-top: 1rem;
    font-size: 1.0625rem;
    color: var(--color-text);
  }
  .sc-change s {
    color: var(--color-text-faint);
    text-decoration-color: var(--color-accent);
  }
  .sc-change b {
    font-weight: 500;
    font-size: 1.25rem;
    color: var(--color-accent);
  }
  .sc-reason {
    margin-top: 0.75rem;
    padding-left: 0.75rem;
    border-left: 2px solid var(--color-accent);
    font-size: 0.875rem;
    line-height: 1.55;
    color: #d8cfbd;
  }

  .sc-history {
    padding: 0;
    list-style: none;
  }
  .sc-history li {
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .sc-history li:first-child {
    padding-top: 0;
  }
  .sc-history p {
    display: flex;
    justify-content: space-between;
    font-size: 0.9375rem;
    color: var(--color-text);
  }
  .sc-history p span:last-child {
    color: var(--color-text-faint);
  }
  .sc-history small {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  /* --- Loop closing back on itself --- */
  .loop-close {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1.5rem;
    padding-left: 2rem;
  }
  .loop-return {
    position: absolute;
    left: calc(var(--x) - 60px * 0.5);
    top: -0.5rem;
    width: 60px;
    height: auto;
    overflow: visible;
  }
  .loop-return path {
    stroke: var(--color-accent);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  .loop-close p {
    margin-left: 2.5rem;
    font-size: 1.125rem;
    color: #e2d9c6;
  }
  @media (min-width: 900px) {
    .loop-close {
      justify-content: center;
      padding: 3rem 0 0;
    }
    .loop-return {
      left: calc(50% - 30px);
      top: 0;
    }
    .loop-close p {
      margin: 2.6rem 0 0;
      text-align: center;
    }
  }

  /* --- Each screen plays its one change when it enters --- */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .loop-step:not(.is-in) .screen {
      opacity: 0;
      transform: translate3d(0, 1.5rem, 0) scale(0.98);
    }
    :global(.js) .loop-step.is-in .screen {
      transition:
        opacity 0.8s var(--ease-premium),
        transform 0.9s var(--ease-premium);
    }
    :global(.js) .loop-step:not(.is-in) .sc-week li {
      opacity: 0;
      transform: translate3d(-0.6rem, 0, 0);
    }
    :global(.js) .loop-step.is-in .sc-week li {
      transition:
        opacity 0.5s var(--ease-premium) calc(0.25s + var(--k) * 0.07s),
        transform 0.5s var(--ease-premium) calc(0.25s + var(--k) * 0.07s);
    }
    :global(.js) .loop-step:not(.is-in) .sc-checkin li > i > i {
      transform: scaleX(0);
    }
    :global(.js) .loop-step.is-in .sc-checkin li > i > i {
      transition: transform 0.9s var(--ease-premium) calc(0.3s + var(--k) * 0.1s);
    }
    :global(.js) .loop-step:not(.is-in) .sc-chosen {
      transform: translate3d(0, 0, 0);
    }
    :global(.js) .loop-step.is-in .sc-chosen {
      transition: transform 0.6s cubic-bezier(0.34, 1.4, 0.64, 1) 0.6s;
    }
    :global(.js) .loop-step:not(.is-in) .sc-options .is-chosen {
      color: var(--color-text-muted) !important;
    }
    :global(.js) .loop-step.is-in .sc-options .is-chosen {
      transition: color 0.2s ease 0.85s;
    }
    :global(.js) .loop-step:not(.is-in) .sc-change b,
    :global(.js) .loop-step:not(.is-in) .sc-reason {
      opacity: 0;
    }
    :global(.js) .loop-step.is-in .sc-change b,
    :global(.js) .loop-step.is-in .sc-reason {
      transition: opacity 0.5s ease 1.1s;
    }
    :global(.js) .loop-step:not(.is-in) .sc-history li {
      opacity: 0;
      transform: translate3d(-0.75rem, 0, 0);
    }
    :global(.js) .loop-step.is-in .sc-history li {
      transition:
        opacity 0.5s var(--ease-premium) calc(0.3s + var(--k) * 0.15s),
        transform 0.5s var(--ease-premium) calc(0.3s + var(--k) * 0.15s);
    }
    :global(.js) .loop-close:not(.is-in) .loop-return path {
      stroke-dashoffset: 1;
    }
    :global(.js) .loop-close.is-in .loop-return path {
      transition: stroke-dashoffset 1s var(--ease-route) 0.2s;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .loop-fill {
      transform: none;
    }
  }
  :global(html:not(.js)) .loop-fill {
    transform: none;
  }
</style>
