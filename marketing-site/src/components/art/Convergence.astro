---
// ART-02 — several inputs converging into one point (the race line motif):
// Act III (technique, physique, mental -> jour de course) and /coaching
// (the daily arbitration -> one explained session). Scroll-linked: the host
// section sets --p (0..1) as it crosses the screen; each line draws in turn,
// its label lights up, the ring closes at the end. Never scroll-jacked.
// No JS / reduced motion: --p = 1, everything drawn.
interface Props {
  inputs: string[];
  outcome: string;
  label?: string;
}

const { inputs, outcome, label = "Convergence" } = Astro.props;
const n = inputs.length;
const spacing = n > 1 ? Math.min(58, 176 / (n - 1)) : 0;
const ys = inputs.map((_, i) => 110 + (i - (n - 1) / 2) * spacing);
---

<figure class="convergence" aria-label={`${inputs.join(", ")} : ${outcome}`} data-label={label}>
  <svg class="cv-svg" viewBox="0 0 560 220" fill="none" aria-hidden="true" focusable="false">
    {ys.map((y) => <line class="cv-ghost" x1="196" y1={y} x2="486" y2="110" />)}
    {ys.map((y, k) => <path class="cv-line" style={`--k: ${k}`} pathLength="1" d={`M 196 ${y} C 330 ${y}, 380 110, 486 110`} />)}
    {ys.map((y, k) => <circle class="cv-start" style={`--k: ${k}`} cx="196" cy={y} r="4" />)}
    <circle class="cv-ring" cx="500" cy="110" r="13"></circle>
    <circle class="cv-core" cx="500" cy="110" r="5"></circle>
  </svg>
  {
    inputs.map((input, k) => (
      <span class="cv-label" style={`--k: ${k}; top: ${(ys[k]! / 220) * 100}%`} aria-hidden="true">
        {input}
      </span>
    ))
  }
  <span class="cv-outcome" aria-hidden="true">{outcome}</span>
</figure>

<style>
  .convergence {
    --p: 1;
    position: relative;
    margin: 0;
    width: 100%;
    max-width: 34rem;
  }
  :global(.js) .convergence {
    --p: var(--progress, 0);
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .convergence {
      --p: 1;
    }
  }
  .cv-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .cv-ghost {
    stroke: rgb(240 238 231 / 0.1);
    stroke-width: 1;
    stroke-dasharray: 3 6;
  }
  .cv-line {
    --t: min(1, max(0, calc(var(--p) * 1.35 - var(--k) * 0.15)));
    stroke: var(--color-accent);
    stroke-width: 2.25;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: calc(1 - var(--t));
  }
  .cv-start {
    --t: min(1, max(0, calc(var(--p) * 1.35 - var(--k) * 0.15)));
    fill: var(--color-accent);
    opacity: calc(0.3 + 0.7 * min(1, var(--t) * 6));
  }
  .cv-ring {
    --t: min(1, max(0, calc((var(--p) - 0.82) * 6)));
    stroke: var(--color-accent);
    stroke-width: 1.75;
    fill: var(--color-bg);
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(calc(0.55 + 0.45 * var(--t)));
    opacity: calc(0.35 + 0.65 * var(--t));
  }
  .cv-core {
    --t: min(1, max(0, calc((var(--p) - 0.9) * 10)));
    fill: var(--color-accent);
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(var(--t));
  }
  .cv-label {
    --t: min(1, max(0, calc(var(--p) * 1.35 - var(--k) * 0.15)));
    position: absolute;
    left: 0;
    width: calc(196 / 560 * 100% - 0.9rem);
    text-align: right;
    font-size: 0.9375rem;
    line-height: 1.2;
    color: var(--color-text);
    opacity: calc(0.4 + 0.6 * min(1, var(--t) * 5));
    transform: translate3d(0, -50%, 0);
  }
  /* Right-aligned under the ring: never wider than the figure. */
  .cv-outcome {
    --t: min(1, max(0, calc((var(--p) - 0.85) * 7)));
    position: absolute;
    right: 0;
    top: calc(110 / 220 * 100% + 1.5rem);
    max-width: 62%;
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.3;
    text-align: right;
    color: var(--color-accent);
    opacity: calc(0.35 + 0.65 * var(--t));
  }
  @media (max-width: 479px) {
    .cv-label {
      font-size: 0.8125rem;
    }
    .cv-outcome {
      font-size: 0.875rem;
    }
  }
</style>
