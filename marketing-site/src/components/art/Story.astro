---
// ART-02.1 — the three acts of the homepage (le point de départ, le coaching
// quotidien, le jour de course) held together by one gold race line running
// down the page gutter at every width (ART-02: desktop only). It starts on the
// first act's ring, fills with the scroll, and each act's ring turns gold when
// the line reaches it. Purely decorative, never scroll-jacked; complete
// without JS.
---

<div class="story" data-story>
  <div class="spine" aria-hidden="true">
    <div class="art-wrap spine-wrap">
      <span class="spine-track"></span>
      <span class="spine-fill"></span>
    </div>
  </div>
  <slot />
</div>

<style>
  /* The spine sits in the middle of the page gutter at every width (--pad = .art-wrap padding). */
  .story {
    --spine-p: 1;
    --pad: 1.25rem;
    --ring: 0.75rem;
    position: relative;
  }
  @media (min-width: 640px) {
    .story {
      --pad: 2rem;
      --ring: 0.9rem;
    }
  }
  @media (min-width: 1024px) {
    .story {
      --pad: 3rem;
      --ring: 1rem;
    }
  }
  :global(.js) .story {
    --spine-p: var(--story-progress, 0);
  }
  .spine {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
  }
  .spine-wrap {
    position: relative;
    height: 100%;
  }
  .spine-track,
  .spine-fill {
    position: absolute;
    left: calc(var(--pad) / 2);
    top: var(--spine-top, 4rem);
    bottom: 0;
    width: 0;
  }
  .spine-track {
    border-left: 1px dashed rgb(213 189 134 / 0.28);
  }
  .spine-fill {
    width: 2px;
    margin-left: -1px;
    background: linear-gradient(180deg, var(--color-accent), rgb(213 189 134 / 0.8));
    transform-origin: top;
    transform: scaleY(var(--spine-p));
  }
  /* Each act's ring sits on the line and lights when the line reaches it. */
  .story :global(.act-label) {
    position: relative;
  }
  .story :global(.act-label)::before {
    position: absolute;
    left: calc(var(--pad) / -2 - var(--ring) / 2);
    width: var(--ring);
    height: var(--ring);
    background: var(--color-bg);
    transition:
      background-color 0.35s ease,
      transform 0.35s var(--ease-premium);
  }
  .story :global(.act-label.is-reached)::before,
  :global(html:not(.js)) .story :global(.act-label)::before {
    background: var(--color-accent);
    transform: scale(1.15);
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .story {
      --spine-p: 1;
    }
    .story :global(.act-label)::before {
      background: var(--color-accent);
    }
  }
</style>

<script>
  import { onScrollFrame } from "../../scripts/core.ts";

  document.querySelectorAll<HTMLElement>("[data-story]").forEach((story) => {
    const markers = [...story.querySelectorAll<HTMLElement>("[data-act-marker]")];
    const fill = story.querySelector<HTMLElement>(".spine-fill");
    // The line starts on the first act's ring, wherever the layout puts it.
    const placeTop = () => {
      const first = markers[0];
      if (!first) return;
      const top = first.getBoundingClientRect().top - story.getBoundingClientRect().top + first.offsetHeight / 2;
      story.style.setProperty("--spine-top", `${Math.round(top)}px`);
    };
    placeTop();
    document.fonts?.ready.then(placeTop);
    window.addEventListener("resize", placeTop, { passive: true });
    onScrollFrame(story, () => {
      const rect = story.getBoundingClientRect();
      const line = window.innerHeight * 0.55;
      // The tip of the gold fill sits on the trigger line, so rings light exactly as it passes.
      const offset = fill?.offsetTop ?? 0;
      const p = Math.min(1, Math.max(0, (line - rect.top - offset) / Math.max(1, rect.height - offset)));
      story.style.setProperty("--story-progress", p.toFixed(4));
      for (const marker of markers) marker.classList.toggle("is-reached", marker.getBoundingClientRect().top < line);
    });
  });
</script>
