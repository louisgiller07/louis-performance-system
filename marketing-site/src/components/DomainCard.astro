---
// The homepage preview list's row card — name + description only. The
// richer example-and-icon card shape lives in CoachingDomainCard.astro
// (/coaching only).
import type { CoachingDomain } from "../content/domains.ts";

interface Props {
  domain: CoachingDomain;
  /** 1-based position, rendered as a small paddock-style number (e.g. 1 → "01"). */
  index: number;
}

const { domain, index } = Astro.props;
const indexLabel = String(index).padStart(2, "0");
---

<div class="bg-surface p-6">
  <span class="font-mono text-xs text-accent">{indexLabel}</span>
  <h3 class="mt-2 text-base font-semibold tracking-wide text-text">{domain.name}</h3>
  <p class="mt-2 text-sm leading-relaxed text-text-muted">{domain.description}</p>
</div>
