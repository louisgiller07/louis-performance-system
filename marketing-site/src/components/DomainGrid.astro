---
// V2 — since Marketing Site Premium Redesign, the richer "reference grid
// with examples" shape moved to CoachingDomainCard.astro (used directly by
// /coaching, which is the only page that ever passed variant="full" here) —
// this component is now single-purpose: the compact name+description scan
// list used by the homepage's "Domaines de coaching" preview section.
import type { CoachingDomain } from "../content/domains.ts";
import DomainCard from "./DomainCard.astro";

interface Props {
  domains: CoachingDomain[];
}

const { domains } = Astro.props;
---

<div class="grid grid-cols-1 gap-px overflow-hidden border border-border bg-border">
  {domains.map((domain, i) => <DomainCard domain={domain} index={i + 1} />)}
</div>
