---
// /comment-ca-marche — chapter 02. The three outcomes of a day, as a
// triptych: same objective, three ways to get there. "Ajuster" — the one
// the homepage story lands on — carries the gold.
import { howPage } from "../../content/pages.ts";
import SectionKicker from "../sections/SectionKicker.astro";

const { decisions } = howPage;
---

<section class="trio grain relative border-t border-border py-24 sm:py-32">
  <div class="mx-auto w-full max-w-7xl px-6 sm:px-8">
    <SectionKicker index={decisions.index} label={decisions.kicker} />
    <h2 class="mt-8 font-display text-[clamp(2.6rem,7vw,5.5rem)] font-extrabold uppercase leading-[0.97] text-text">
      {
        decisions.titleLines.map((line, i) => (
          <span class:list={["block", i === 1 && "text-text-muted"]} data-reveal style={`--reveal-delay: ${i * 110}ms`}>
            {line}
          </span>
        ))
      }
    </h2>

    <ol class="mt-16 grid grid-cols-1 border-t border-border md:grid-cols-3">
      {
        decisions.items.map((item, i) => (
          <li
            class:list={[
              "flex flex-col border-b border-border py-10 md:border-b-0 md:py-12 md:pr-8",
              i > 0 && "md:border-l md:pl-8",
            ]}
            data-reveal
            style={`--reveal-delay: ${i * 120}ms`}
          >
            <span class="font-mono text-xs text-text-muted">{String(i + 1).padStart(2, "0")}</span>
            <h3
              class:list={[
                "mt-4 font-display text-[clamp(2.75rem,5.5vw,4.5rem)] font-extrabold uppercase leading-none",
                item.highlighted ? "text-accent" : "text-text",
              ]}
            >
              {item.word}
            </h3>
            <p class="mt-8 font-mono text-[0.65rem] uppercase tracking-[0.2em] text-text-muted">Quand</p>
            <p class="mt-2 text-lg text-text">{item.when}</p>
            <p class="mt-6 font-mono text-[0.65rem] uppercase tracking-[0.2em] text-text-muted">Alors</p>
            <p class="mt-2 text-base leading-relaxed text-text-muted">{item.result}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .trio {
    background:
      radial-gradient(ellipse 60% 50% at 50% 60%, rgb(22 38 30 / 0.5), transparent 70%),
      linear-gradient(to bottom, var(--color-bg), var(--color-pine) 30%, var(--color-pine) 70%, var(--color-bg));
  }
</style>
