---
import Badge from "./ui/Badge.astro";

interface Props {
  athleteContext: string;
  image?: { src: string; alt: string };
}

const { athleteContext, image } = Astro.props;
---

{
  image ? (
    <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-[minmax(0,320px)_1fr] lg:gap-12">
      <div class="aspect-[2/3] w-full overflow-hidden border border-accent/25 bg-surface">
        <img
          src={image.src}
          alt={image.alt}
          class="h-full w-full object-cover"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="border-l-2 border-accent pl-6">
        <Badge as="h2">Construit et testé par</Badge>
        <p class="mt-3 text-base leading-relaxed text-text-muted">{athleteContext}</p>
      </div>
    </div>
  ) : (
    <div class="max-w-2xl border-l-2 border-accent pl-6">
      <Badge as="h2">Construit et testé par</Badge>
      <p class="mt-3 text-base leading-relaxed text-text-muted">{athleteContext}</p>
    </div>
  )
}
