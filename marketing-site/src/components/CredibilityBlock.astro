---
// Image + text credibility block. V1.8: no longer owns its own heading
// internally (was hardcoded "Construit et testé par") — the caller renders
// its own Badge/h2 outside this component, exactly like every other
// homepage section (Le problème, La boucle NALYNT, ...). This lets the same
// block carry a different heading on /a-propos ("Louis Giller") without
// forking the component.
interface Props {
  text: string;
  image?: { src: string; alt: string };
}

const { text, image } = Astro.props;
---

{
  image ? (
    <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-[minmax(0,320px)_1fr] lg:gap-12">
      <div class="aspect-[2/3] w-full overflow-hidden border border-accent/25 bg-surface">
        <img
          src={image.src}
          alt={image.alt}
          class="h-full w-full object-cover"
          loading="lazy"
          decoding="async"
        />
      </div>
      <p class="border-l-2 border-accent pl-6 text-base leading-relaxed text-text-muted">{text}</p>
    </div>
  ) : (
    <p class="max-w-2xl border-l-2 border-accent pl-6 text-base leading-relaxed text-text-muted">{text}</p>
  )
}
