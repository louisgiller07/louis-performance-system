---
// Inner-page hero (/comment-ca-marche, /coaching): the homepage's typographic
// language without a photo — condensed headline revealed line by line (last
// line in gold), deep pine light, grain and the same sparse dust layer
// (scripts/motion.ts). One primary CTA, a scroll cue to the first chapter.
import Button from "../ui/Button.astro";
import type { PageHeroCopy } from "../../content/pages.ts";
import { home } from "../../content/home.ts";

interface Props {
  hero: PageHeroCopy;
  /** Anchor of the page's first chapter, for the scroll cue. */
  next: string;
}

const { hero, next } = Astro.props;
const last = hero.titleLines.length - 1;
---

<section class="page-hero grain relative isolate flex min-h-[calc(78svh-4rem)] flex-col justify-end overflow-hidden">
  <canvas class="pointer-events-none absolute inset-0 -z-10 h-full w-full" data-dust aria-hidden="true"></canvas>
  <div class="mx-auto w-full max-w-7xl px-6 pb-14 pt-24 sm:px-8 sm:pb-20">
    <p class="hero-in font-mono text-[0.7rem] uppercase tracking-[0.28em] text-accent">
      <span class="mr-3 inline-block h-px w-8 bg-accent align-middle" aria-hidden="true"></span>{hero.kicker}
    </p>
    <h1 class="mt-6 font-display text-[clamp(3rem,min(11vw,15vh),8.5rem)] font-extrabold uppercase leading-[0.9] text-text">
      {
        hero.titleLines.map((line, i) => (
          <span class="hero-line">
            <span class:list={[i === last && "text-accent"]} style={`--d: ${120 + i * 110}ms`}>
              {line}
            </span>
          </span>
        ))
      }
    </h1>
    <div class="mt-8 flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <p class="hero-in max-w-xl text-lg leading-relaxed text-text-muted sm:text-xl" style="--d: 450ms">{hero.intro}</p>
        <div class="hero-in mt-8" style="--d: 560ms">
          <Button href={home.hero.primary.href} size="lg" arrow>{home.hero.primary.label}</Button>
        </div>
      </div>
      <a
        href={next}
        class="hero-in hidden flex-col items-center gap-3 font-mono text-[0.65rem] uppercase tracking-[0.3em] text-text-muted hover:text-text lg:flex"
        style="--d: 700ms"
      >
        Défiler
        <span class="relative block h-12 w-px overflow-hidden bg-border" aria-hidden="true"><span class="scroll-cue-dot"></span></span>
      </a>
    </div>
  </div>
</section>

<style>
  .page-hero {
    background:
      radial-gradient(ellipse 70% 60% at 85% 10%, rgb(22 38 30 / 0.75), transparent 70%),
      linear-gradient(to bottom, var(--color-pine), var(--color-bg));
  }
  .scroll-cue-dot {
    position: absolute;
    left: 0;
    top: 0;
    width: 1px;
    height: 40%;
    background: var(--color-accent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .scroll-cue-dot {
      animation: cue 2.2s var(--ease-premium) infinite 1.6s;
    }
  }
  @keyframes cue {
    0% {
      transform: translateY(-100%);
    }
    100% {
      transform: translateY(260%);
    }
  }
</style>
