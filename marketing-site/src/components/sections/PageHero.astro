---
// Inner-page hero: the homepage's typographic language — condensed headline
// revealed line by line (last line in gold), deep pine light, grain and the
// same sparse dust layer (scripts/motion.ts). Optional graded full-bleed
// photo (/a-propos), optional primary CTA, compact height (/contact), and a
// scroll cue to the page's first chapter.
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import Button from "../ui/Button.astro";
import type { PageHeroCopy } from "../../content/pages.ts";
import { home } from "../../content/home.ts";

interface Props {
  hero: PageHeroCopy;
  /** Anchor of the page's first chapter, for the scroll cue. */
  next?: string;
  image?: { src: ImageMetadata; alt: string };
  /** Show the "Commencer gratuitement" button (default true). */
  cta?: boolean;
  compact?: boolean;
}

const { hero, next, image, cta = true, compact = false } = Astro.props;
const last = hero.titleLines.length - 1;
---

<section
  class:list={[
    "page-hero grain relative isolate flex flex-col justify-end overflow-hidden",
    compact ? "min-h-[calc(52svh-4rem)]" : "min-h-[calc(78svh-4rem)]",
    image && "has-image",
  ]}
>
  {
    image && (
      <>
        <div class="absolute inset-0 -z-20">
          <Picture
            src={image.src}
            formats={["avif", "webp"]}
            widths={[640, 960, 1280, 1920]}
            width={1920}
            sizes="100vw"
            alt={image.alt}
            loading="eager"
            fetchpriority="high"
            class="page-hero-img h-full w-full object-cover"
          />
        </div>
        <div class="page-hero-shade pointer-events-none absolute inset-0 -z-10" aria-hidden="true" />
      </>
    )
  }
  <canvas class="pointer-events-none absolute inset-0 -z-10 h-full w-full" data-dust aria-hidden="true"></canvas>
  <div class="mx-auto w-full max-w-7xl px-6 pb-14 pt-24 sm:px-8 sm:pb-20">
    <p class="hero-in font-mono text-[0.7rem] uppercase tracking-[0.28em] text-accent">
      <span class="mr-3 inline-block h-px w-8 bg-accent align-middle" aria-hidden="true"></span>{hero.kicker}
    </p>
    <h1 class="mt-6 font-display text-[clamp(3rem,min(11vw,15vh),8.5rem)] font-extrabold uppercase leading-[0.9] text-text">
      {
        hero.titleLines.map((line, i) => (
          <span class="hero-line">
            <span class:list={[i === last && "text-accent"]} style={`--d: ${120 + i * 110}ms`}>
              {line}
            </span>
          </span>
        ))
      }
    </h1>
    <div class="mt-8 flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <p class="hero-in max-w-xl text-lg leading-relaxed text-text-muted sm:text-xl" style="--d: 450ms">{hero.intro}</p>
        {
          cta && (
            <div class="hero-in mt-8" style="--d: 560ms">
              <Button href={home.hero.primary.href} size="lg" arrow>
                {home.hero.primary.label}
              </Button>
            </div>
          )
        }
      </div>
      {
        next && (
          <a
            href={next}
            class="hero-in hidden flex-col items-center gap-3 font-mono text-[0.65rem] uppercase tracking-[0.3em] text-text-muted hover:text-text lg:flex"
            style="--d: 700ms"
          >
            Défiler
            <span class="relative block h-12 w-px overflow-hidden bg-border" aria-hidden="true">
              <span class="scroll-cue-dot" />
            </span>
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .page-hero {
    background:
      radial-gradient(ellipse 70% 60% at 85% 10%, rgb(22 38 30 / 0.75), transparent 70%),
      linear-gradient(to bottom, var(--color-pine), var(--color-bg));
  }
  .page-hero.has-image {
    background: var(--color-bg);
  }
  .page-hero :global(picture) {
    display: block;
    height: 100%;
  }
  .page-hero-img {
    object-position: 62% 40%;
    filter: grayscale(0.35) contrast(1.1) brightness(0.5);
  }
  .page-hero-shade {
    background: linear-gradient(to top, var(--color-bg) 0%, rgb(8 9 9 / 0.55) 40%, rgb(11 19 15 / 0.3) 75%, rgb(8 9 9 / 0.6) 100%);
  }
  .scroll-cue-dot {
    position: absolute;
    left: 0;
    top: 0;
    width: 1px;
    height: 40%;
    background: var(--color-accent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .page-hero-img {
      animation: hero-settle 2.4s var(--ease-premium) both;
    }
    .scroll-cue-dot {
      animation: cue 2.2s var(--ease-premium) infinite 1.6s;
    }
  }
  @keyframes hero-settle {
    from {
      transform: scale(1.08);
    }
  }
  @keyframes cue {
    0% {
      transform: translateY(-100%);
    }
    100% {
      transform: translateY(260%);
    }
  }
</style>
