---
// Editorial storytelling block — deliberately not a bordered "card", to read
// as a human/brand moment rather than another data block. `content` must
// come from content/copy.ts (siteCopy.storyOrigin / siteCopy.aboutPage.hero)
// — this component adds no copy of its own. V1.5: rewritten in place (same
// file, same original call site on `/`) to carry the full "Pourquoi NALYNT
// existe" structure rather than a single paragraph. V1.8: props relaxed
// (title/intro flexible, turn/origin/approach optional) so the same
// component also carries the shorter /a-propos hero content without
// inventing fields it doesn't have.
//
// `image` stays optional, ready for a future photo (not used today): no
// structural change will be needed when one is supplied.
import type { StoryOriginCopy } from "../content/copy.ts";

interface Props {
  content: StoryOriginCopy;
  image?: { src: string; alt: string };
  imagePosition?: "left" | "right";
  /** Heading level for `content.title` — "h1" when this block opens a page (/a-propos hero), "h3" when nested under a page h2 (home). */
  titleAs?: "h1" | "h2" | "h3";
}

const { content, image, imagePosition = "left", titleAs = "h3" } = Astro.props;
const titleLines = Array.isArray(content.title) ? content.title : [content.title];
const Title = titleAs;
---

<div class:list={["grid grid-cols-1 gap-10", image && "lg:grid-cols-2 lg:gap-16 lg:items-start"]}>
  {
    image && (
      <div
        class:list={[
          "aspect-[3/2] w-full overflow-hidden border border-accent/25 bg-surface",
          imagePosition === "right" && "lg:order-2",
        ]}
      >
        <img
          src={image.src}
          alt={image.alt}
          class="h-full w-full object-cover"
          loading="lazy"
          decoding="async"
        />
      </div>
    )
  }

  <div class:list={["max-w-2xl", image && imagePosition === "right" && "lg:order-1"]}>
    <Title class="text-3xl font-semibold leading-tight tracking-tight text-text sm:text-4xl lg:text-5xl">
      {titleLines.map((line, i) => (
        <>
          {i > 0 && <br />}
          {line}
        </>
      ))}
    </Title>

    {content.intro.map((paragraph) => (
      <p class="mt-10 text-lg leading-relaxed text-text-muted first:mt-10">{paragraph}</p>
    ))}

    <div class="mt-8 flex flex-col gap-3">
      {
        content.contrastList.map((line) => (
          <div class="flex items-baseline gap-3">
            <span class="h-px w-4 shrink-0 bg-accent" aria-hidden="true" />
            <span class="text-lg text-text-muted">{line}</span>
          </div>
        ))
      }
    </div>

    {content.turn && <p class="mt-8 text-lg leading-relaxed text-text">{content.turn}</p>}
    {content.origin && <p class="mt-10 text-lg leading-relaxed text-text-muted">{content.origin}</p>}
    {content.approach && <p class="mt-6 text-lg leading-relaxed text-text-muted">{content.approach}</p>}

    <div class="mt-12 border-t border-border pt-10">
      <p class="text-base leading-relaxed text-text-muted">{content.questionIntro}</p>
      <p class="mt-3 text-lg text-text-muted italic">« {content.questionOld} »</p>

      <p class="mt-6 flex items-center gap-2 font-mono text-xs uppercase tracking-[0.2em] text-accent">
        <span class="h-px w-6 bg-accent" aria-hidden="true" />
        {content.questionBridge}
      </p>
      <p class="mt-3 text-2xl font-semibold leading-snug text-text sm:text-3xl">
        « {content.questionNew} »
      </p>
    </div>
  </div>
</div>
