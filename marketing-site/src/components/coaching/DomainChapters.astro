---
// /coaching — chapter 01, the seven domains. Desktop: a sticky index on the
// left (01–07) whose current entry lights up as its chapter crosses the
// middle of the viewport (scripts/motion.ts); each chapter is a big name,
// a rider promise, and one concrete "sur le terrain" example. Mobile: the
// chapters simply stack.
import { domains } from "../../content/domains.ts";
import { coachingPage } from "../../content/pages.ts";
import SectionKicker from "../sections/SectionKicker.astro";
import CoachingDomainIcon from "../CoachingDomainIcon.astro";

const { domains: copy } = coachingPage;
const num = (i: number) => String(i + 1).padStart(2, "0");
---

<section id="domaines" class="scroll-mt-16 border-t border-border bg-bg py-24 sm:py-32" data-domains>
  <div class="mx-auto grid w-full max-w-7xl gap-10 px-6 sm:px-8 lg:grid-cols-[minmax(0,3fr)_minmax(0,9fr)] lg:gap-20">
    <div class="lg:sticky lg:top-32 lg:self-start">
      <SectionKicker index={copy.index} label={copy.kicker} />
      <ol class="mt-10 hidden flex-col gap-3 lg:flex" aria-hidden="true">
        {
          domains.map((domain, i) => (
            <li class="domain-index flex items-baseline gap-4" data-domain-index={i}>
              <span class="font-mono text-xs">{num(i)}</span>
              <span class="text-sm">{domain.name}</span>
            </li>
          ))
        }
      </ol>
    </div>

    <ol>
      {
        domains.map((domain, i) => (
          <li class="border-t border-border py-12 first:border-t-0 first:pt-0 sm:py-16 lg:first:pt-4" data-domain={i} data-reveal>
            <div class="flex items-center gap-4 text-accent">
              <CoachingDomainIcon id={domain.id} class="h-7 w-7" />
              <span class="font-mono text-xs tracking-[0.2em]">{num(i)}</span>
            </div>
            <h2 class="mt-5 font-display text-[clamp(2.75rem,7vw,5.75rem)] font-extrabold uppercase leading-[0.97] text-text">
              {domain.name}
            </h2>
            <div class="mt-8 grid gap-8 md:grid-cols-2 md:gap-12">
              <p class="text-2xl leading-snug text-text sm:text-[1.7rem]">{domain.promise}</p>
              <div class="border-l border-accent pl-5">
                <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-accent">{copy.fieldLabel}</p>
                <p class="mt-3 text-base leading-relaxed text-text-muted">{domain.field}</p>
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .domain-index {
    color: var(--color-text-muted);
    transition: color 0.4s var(--ease-premium);
  }
  .domain-index > span:first-child {
    transition: color 0.4s var(--ease-premium);
  }
  .domain-index.is-current {
    color: var(--color-text);
  }
  .domain-index.is-current > span:first-child {
    color: var(--color-accent);
  }
</style>
