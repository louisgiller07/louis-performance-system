     expect(finalPrescriptions()).toBe(fpsBefore);
   });
 
+  it("BETA-V2-TECH-01 T2 (integration S3) — after the revocation, the production daily run blocks a unit-less DH of the legacy rider on the unit requirement: nothing prescribed (the revocation proof itself stays on the signed rider)", async () => {
