+  it("BETA-V2-TECH-01 T2 (integration S3) — the production daily run now requires the signed unit: the legacy rider's unit-less DH day is blocked (dh_repetition_unit_unknown), nothing prescribed", async () => {
+    const day = "2026-10-05";
+    await insertCheckin(admin, riders.legacy, day);
